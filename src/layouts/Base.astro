---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonicalURL?: string;
  lang?: 'en' | 'pt';
  noindex?: boolean;
}

const {
  title = 'Jeferson Freiry — Product Designer',
  description = 'Senior Product Designer focused on complex enterprise systems. I design data-driven products and AI-powered platforms that help organizations access knowledge, streamline workflows, and make better decisions.',
  ogImage = '/og-default.png',
  ogType = 'website',
  canonicalURL = Astro.url.href,
  lang = 'en',
  noindex = false,
} = Astro.props;

const siteURL = 'https://portfolio.jefersonfreiry.com';
const enURL = canonicalURL.replace('/pt/', '/').replace(/\/pt$/, '/');
const ptURL = canonicalURL.includes('/pt') ? canonicalURL : canonicalURL.replace(siteURL, `${siteURL}/pt`);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <!-- Anti-flash: aplica tema antes do render -->
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Title & Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical & hreflang -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="pt" href={ptURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteURL}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'pt_BR'} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteURL}${ogImage}`} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Fontes self-hosted — sem round-trip para fonts.googleapis.com -->
    <link rel="preload" href="/fonts/barlow-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-serif-display.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Preconnect para Unsplash (hero bgImage + CaseCard placeholders) -->
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />

    <!-- View Transitions API (Astro 6) -->
    <meta name="view-transition" content="same-origin" />

    <!-- Vercel Web Analytics -->
    <Analytics />
  </head>
  <body class="antialiased">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
  </body>

  <script>
    function initAnimations() {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.setAttribute('data-visible', '');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }
      );
      document.querySelectorAll('[data-animate]:not([data-visible])').forEach((el) => {
        observer.observe(el);
      });
    }

    // Roda no carregamento inicial
    initAnimations();

    // Roda após cada transição de página (View Transitions API)
    document.addEventListener('astro:page-load', initAnimations);
  </script>
</html>
