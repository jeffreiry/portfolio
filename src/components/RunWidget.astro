---
interface Props {
  lang: 'en' | 'pt';
}
const { lang } = Astro.props;

let totalKm: number | null = null;
let count = 0;

try {
  const res = await fetch('https://painel-saude-zeta.vercel.app/api/weekly-run');
  if (res.ok) {
    const data = await res.json();
    if (data) { totalKm = data.total_km; count = data.count; }
  }
} catch { /* skip */ }

const title   = lang === 'pt' ? 'Corrida esta semana' : 'Running This Week';
const runs    = lang === 'pt'
  ? `${count} ${count === 1 ? 'corrida' : 'corridas'}`
  : `${count} ${count === 1 ? 'run' : 'runs'}`;
const syncing = lang === 'pt' ? 'Sincroniza com Strava' : 'Syncing with Strava';
---

{totalKm !== null && (
  <div class="run-widget" aria-label={`${title}: ${totalKm} km`}>
    <div class="run-widget__top">
      <span class="run-widget__title">{title}</span>
      <!-- Strava logo -->
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="run-widget__logo">
        <path d="M10.5 3L6 13.5h3.9L12 9l2.1 4.5H18L13.5 3H10.5z" fill="#FC4C02"/>
        <path d="M14.1 13.5L12 17.7l-2.1-4.2H6.9L12 21l5.1-7.5H14.1z" fill="#FC4C02" opacity="0.6"/>
      </svg>
    </div>

    <div class="run-widget__number">
      {totalKm}<span class="run-widget__unit"> km</span>
    </div>

    <div class="run-widget__bottom">
      <span class="run-widget__count">{runs}</span>
      <span class="run-widget__sync">{syncing}</span>
    </div>
  </div>
)}

<style>
  .run-widget {
    background: var(--color-surface);
    border-radius: 16px;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .run-widget__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .run-widget__title {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 13px;
    font-weight: 700;
    color: #FC4C02;
    line-height: 1.2;
  }

  :global(html[data-theme="dark"]) .run-widget__title {
    color: var(--color-ink);
  }

  .run-widget__number {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 48px;
    font-weight: 800;
    line-height: 1;
    color: #FC4C02;
    letter-spacing: -0.02em;
  }

  :global(html[data-theme="dark"]) .run-widget__number {
    color: var(--color-ink);
  }

  .run-widget__unit {
    font-size: 20px;
    font-weight: 700;
  }

  .run-widget__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .run-widget__count {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 12px;
    font-weight: 700;
    color: #FC4C02;
  }

  :global(html[data-theme="dark"]) .run-widget__count {
    color: var(--color-ink);
  }

  .run-widget__sync {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 12px;
    font-weight: 500;
    color: #FC4C02;
    white-space: nowrap;
  }

  :global(html[data-theme="dark"]) .run-widget__sync {
    color: var(--color-ink);
  }
</style>
