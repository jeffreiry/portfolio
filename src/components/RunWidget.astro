---
interface Props {
  lang: 'en' | 'pt';
}

const { lang } = Astro.props;

let distKm: number | null = null;
let gearModel: string | null = null;
let dateLabel: string | null = null;

try {
  const res = await fetch('https://painel-saude-zeta.vercel.app/api/last-run');
  if (res.ok) {
    const data = await res.json();
    if (data) {
      distKm = Math.round(data.dist_km);
      gearModel = data.gear_model ?? null;

      const date = new Date(data.dateISO + 'T00:00:00');
      dateLabel = date.toLocaleDateString(lang === 'pt' ? 'pt-BR' : 'en-US', {
        day: 'numeric',
        month: 'short',
      });
    }
  }
} catch {
  // silently skip if fetch fails at build time
}

const liveLabel = lang === 'pt' ? 'atualiza toda noite' : 'updates nightly';
const runLabel  = lang === 'pt' ? 'Última corrida' : 'Last run';
---

{distKm !== null && (
  <div
    data-animate
    style="--animate-delay: 240ms"
    class="run-widget w-full"
    aria-label={lang === 'pt' ? `Última corrida: ${distKm} km` : `Last run: ${distKm} km`}
  >
    <!-- Header row -->
    <div class="run-widget__header">
      <div class="run-widget__header-left">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="run-widget__strava">
          <path d="M10.5 3L6 13.5h3.9L12 9l2.1 4.5H18L13.5 3H10.5z" fill="#FC4C02"/>
          <path d="M14.1 13.5L12 17.7l-2.1-4.2H6.9L12 21l5.1-7.5H14.1z" fill="#FC4C02" opacity="0.6"/>
        </svg>
        <span class="run-widget__label">{runLabel}</span>
      </div>
      <div class="run-widget__live">
        <span class="run-widget__dot" aria-hidden="true"></span>
        <span class="run-widget__live-label">{liveLabel}</span>
      </div>
    </div>

    <!-- Data row -->
    <div class="run-widget__data">
      <div class="run-widget__stat">
        <span class="run-widget__number">{distKm}</span>
        <span class="run-widget__unit">km</span>
      </div>

      {dateLabel && (
        <>
          <div class="run-widget__divider" aria-hidden="true"></div>
          <div class="run-widget__stat run-widget__stat--secondary">
            <span class="run-widget__value">{dateLabel}</span>
          </div>
        </>
      )}

      {gearModel && (
        <>
          <div class="run-widget__divider" aria-hidden="true"></div>
          <div class="run-widget__stat run-widget__stat--secondary">
            <span class="run-widget__value">{gearModel}</span>
          </div>
        </>
      )}
    </div>
  </div>
)}

<style>
  .run-widget {
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 16px;
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .run-widget__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .run-widget__header-left {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .run-widget__label {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #555;
  }

  .run-widget__live {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .run-widget__dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    animation: pulse-dot 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.75); }
  }

  .run-widget__live-label {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 10px;
    font-weight: 400;
    color: #3a3a3a;
    white-space: nowrap;
  }

  .run-widget__data {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .run-widget__stat {
    display: flex;
    align-items: baseline;
    gap: 3px;
  }

  .run-widget__number {
    font-family: var(--font-display, 'Cactus Regular', serif);
    font-size: 36px;
    font-weight: 400;
    color: #ffffff;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .run-widget__unit {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 13px;
    font-weight: 500;
    color: #FC4C02;
  }

  .run-widget__divider {
    width: 1px;
    height: 28px;
    background: #2e2e2e;
    flex-shrink: 0;
  }

  .run-widget__stat--secondary {
    align-items: center;
  }

  .run-widget__value {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 12px;
    font-weight: 400;
    color: #666;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 120px;
  }
</style>
