---
interface Props {
  lang: 'en' | 'pt';
}
const { lang } = Astro.props;

let totalKm: number | null = null;
let count = 0;

try {
  const res = await fetch('https://painel-saude-zeta.vercel.app/api/monthly-run');
  if (res.ok) {
    const data = await res.json();
    if (data) { totalKm = data.total_km; count = data.count; }
  }
} catch { /* skip */ }

const title   = lang === 'pt' ? 'Corrida este mês' : 'Running This Month';
const runs    = lang === 'pt'
  ? `${count} ${count === 1 ? 'corrida' : 'corridas'}`
  : `${count} ${count === 1 ? 'run' : 'runs'}`;
const syncing = lang === 'pt' ? 'Sincroniza com Strava' : 'Syncing with Strava';
---

{totalKm !== null && (
  <div class="run-widget" aria-label={`${title}: ${totalKm} km`}>
    <div class="run-widget__top">
      <span class="run-widget__title">{title}</span>
      <img src="/logos/strava.png" alt="Strava" width="28" height="28" class="run-widget__logo" />
    </div>

    <div class="run-widget__number">
      {totalKm}<span class="run-widget__unit"> km</span>
    </div>

    <div class="run-widget__bottom">
      <span class="run-widget__count">{runs}</span>
      <span class="run-widget__sync">
        <span class="run-widget__dot" aria-hidden="true"></span>
        {syncing}
      </span>
    </div>
  </div>
)}

<style>
  .run-widget {
    background: #fafafa;
    border-radius: 16px;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .run-widget__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .run-widget__title {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 14px;
    font-weight: 700;
    color: #FC4C02;
    line-height: 1.2;
  }

  :global(html[data-theme="dark"]) .run-widget {
    background: var(--color-surface);
  }

  :global(html[data-theme="dark"]) .run-widget__title {
    color: var(--color-ink);
  }

  .run-widget__number {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 48px;
    font-weight: 800;
    line-height: 1;
    color: #FC4C02;
    letter-spacing: -0.02em;
  }

  :global(html[data-theme="dark"]) .run-widget__number {
    color: var(--color-ink);
  }

  .run-widget__unit {
    font-size: 20px;
    font-weight: 700;
  }

  .run-widget__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .run-widget__count {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 14px;
    font-weight: 700;
    color: #FC4C02;
  }

  :global(html[data-theme="dark"]) .run-widget__count {
    color: var(--color-ink);
  }

  .run-widget__dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    animation: pulse-dot 2s ease-in-out infinite;
    flex-shrink: 0;
    vertical-align: middle;
    margin-right: 4px;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.75); }
  }

  .run-widget__sync {
    display: flex;
    align-items: center;
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 12px;
    font-weight: 500;
    color: #FC4C02;
    white-space: nowrap;
  }

  :global(html[data-theme="dark"]) .run-widget__sync {
    color: var(--color-ink);
  }

  .run-widget__logo {
    object-fit: contain;
    flex-shrink: 0;
  }

  :global(html[data-theme="dark"]) .run-widget__logo {
    filter: brightness(0) invert(1);
  }
</style>
