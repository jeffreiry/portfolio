---
interface Props {
  lang?: 'en' | 'pt';
}
const { lang = 'en' } = Astro.props;
---

<footer
  class="mx-auto flex max-w-[1200px] items-center justify-between px-5 py-5"
  style="border-top: 0.5px solid var(--color-border); margin-top: 2rem;"
>
  <span
    class="font-display text-[12px] tracking-[0.06em]"
    style="color: var(--color-faint);"
  >
    JEFERSON FREIRY © {new Date().getFullYear()}
  </span>

  <nav class="flex gap-4" aria-label="Footer links">
    <a
      href="https://linkedin.com/in/jefersonfreiry"
      target="_blank"
      rel="noopener noreferrer"
      class="text-[11px] transition-opacity hover:opacity-80"
      style="color: var(--color-faint); font-family: var(--font-body);"
    >
      LinkedIn
    </a>
    <a
      href="https://github.com/jeffreiry"
      target="_blank"
      rel="noopener noreferrer"
      class="text-[11px] transition-opacity hover:opacity-80"
      style="color: var(--color-faint); font-family: var(--font-body);"
    >
      GitHub
    </a>
    <a
      href="mailto:jfreiry@gmail.com"
      class="text-[11px] transition-opacity hover:opacity-80"
      style="color: var(--color-faint); font-family: var(--font-body);"
    >
      {lang === 'en' ? 'Email' : 'E-mail'}
    </a>
  </nav>
</footer>
