---
interface Props {
  lang?: 'en' | 'pt';
}
const { lang = 'en' } = Astro.props;
---

<footer
  class="mx-auto flex max-w-[1200px] items-center justify-between px-5 py-5"
  style="border-top: 0.5px solid var(--color-border); margin-top: 2rem;"
>
  <div class="flex items-center gap-3">
    <img src="/jeferson-black.png" alt="Jeferson Freiry" class="logo-black" style="height: 18px; width: auto; opacity: 0.35;" />
    <img src="/jeferson-white.png" alt="Jeferson Freiry" class="logo-white" style="height: 18px; width: auto; display: none; opacity: 0.35;" />
    <span class="text-[11px]" style="color: var(--color-faint); font-family: var(--font-body);">© {new Date().getFullYear()}</span>
  </div>

  <nav class="flex gap-4" aria-label="Footer links">
    <a
      href="https://linkedin.com/in/jefersonfreiry"
      target="_blank"
      rel="noopener noreferrer"
      class="text-[11px] transition-opacity hover:opacity-80"
      style="color: var(--color-faint); font-family: var(--font-body);"
    >
      LinkedIn
    </a>
    <a
      href="https://github.com/jeffreiry"
      target="_blank"
      rel="noopener noreferrer"
      class="text-[11px] transition-opacity hover:opacity-80"
      style="color: var(--color-faint); font-family: var(--font-body);"
    >
      GitHub
    </a>
    <a
      href="mailto:jfreiry@gmail.com"
      class="text-[11px] transition-opacity hover:opacity-80"
      style="color: var(--color-faint); font-family: var(--font-body);"
    >
      {lang === 'en' ? 'Email' : 'E-mail'}
    </a>
  </nav>
</footer>

<style>
  html[data-theme="dark"] .logo-black { display: none !important; }
  html[data-theme="dark"] .logo-white { display: block !important; }
</style>
