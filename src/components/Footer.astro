---
interface Props {
  lang?: 'en' | 'pt';
}
const { lang = 'en' } = Astro.props;
---

<footer
  class="mx-auto flex max-w-[1200px] items-center justify-between px-5 py-5"
  style="border-top: 0.5px solid var(--border-default); margin-top: 2rem;"
>
  <div class="flex items-center gap-3">
    <img src="/jeferson-black.png" alt="Jeferson Freiry" class="footer-logo" width="17" height="18" style="height: 18px; width: auto; opacity: 0.35;" />
    <span class="text-eyebrow" style="color: var(--text-secondary); font-family: var(--font-body);">© {new Date().getFullYear()}</span>
  </div>

  <nav class="flex gap-4" aria-label="Footer links">
    <a
      href="https://linkedin.com/in/jefersonfreiry"
      target="_blank"
      rel="noopener noreferrer"
      class="text-eyebrow transition-opacity hover:opacity-80"
      style="color: var(--text-secondary); font-family: var(--font-body);"
    >
      LinkedIn
    </a>
    <a
      href="https://github.com/jeffreiry"
      target="_blank"
      rel="noopener noreferrer"
      class="text-eyebrow transition-opacity hover:opacity-80"
      style="color: var(--text-secondary); font-family: var(--font-body);"
    >
      GitHub
    </a>
    <a
      href="mailto:jfreiry@gmail.com"
      class="text-eyebrow transition-opacity hover:opacity-80"
      style="color: var(--text-secondary); font-family: var(--font-body);"
    >
      {lang === 'en' ? 'Email' : 'E-mail'}
    </a>
  </nav>
</footer>

<style>
  html[data-theme="dark"] .footer-logo { filter: brightness(0) invert(1); }
</style>
