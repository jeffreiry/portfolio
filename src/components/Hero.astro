---
interface Props {
  headline: string;
  role?: string;
  body?: string;
  contactLabel?: string;
  contactHref?: string;
  eyebrow?: string;
}

const {
  headline,
  role,
  body,
  contactLabel = 'Get in touch →',
  contactHref = 'mailto:jfreiry@gmail.com',
  eyebrow = 'Product Designer · Porto Alegre, BR',
} = Astro.props;

const [firstName, ...rest] = headline.split(' ');
const lastName = rest.join(' ');
---

<section class="w-full px-5 pt-5">
  <div
    class="relative mx-auto w-full max-w-[1200px] overflow-hidden rounded-[24px] px-10 pb-11 pt-10"
    style="background-color: var(--color-cha-mate);"
  >
    <!-- Eyebrow -->
    <p
      class="mb-3 text-[10px] font-medium uppercase tracking-[0.16em]"
      style="color: rgba(255,255,255,0.35); font-family: var(--font-body);"
    >
      {eyebrow}
    </p>

    <!-- Nome: display condensado, sobrenome em Jambu -->
    <h1
      class="font-display"
      style="font-size: clamp(48px, 7vw, 80px); line-height: 0.92; color: #fff;"
    >
      {firstName}<br />
      <span style="color: var(--color-jambu);">{lastName}</span>
    </h1>

    <!-- Corpo: role + body em bloco único -->
    {(role || body) && (
      <p
        class="mt-4 max-w-[400px] leading-relaxed"
        style="font-size: 14px; font-weight: 500; font-family: var(--font-body); color: rgba(255,255,255,0.55);"
      >
        {body || role}
      </p>
    )}

    <!-- CTA -->
    <a
      href={contactHref}
      class="mt-5 inline-flex items-center gap-2 transition-opacity hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
      style="
        background-color: var(--color-jambu);
        border-radius: var(--radius-pill);
        padding: 9px 20px;
        font-size: 12px;
        font-weight: 500;
        font-family: var(--font-body);
        color: #fff;
        letter-spacing: 0.02em;
      "
    >
      {contactLabel}
    </a>
  </div>
</section>
