---
interface Props {
  headline: string;
  role?: string;
  body?: string;
}
const { headline, role, body } = Astro.props;
---

<section class="w-full px-6 pt-6">
  <div
    class="relative mx-auto w-full max-w-[1200px] overflow-hidden rounded-[32px] bg-neutral-700 px-8 pb-16 pt-40 md:px-16"
    style="opacity: 0.9;"
  >
    <div class="flex flex-col gap-4">
      <h1
        class="font-display text-[clamp(32px,5vw,60px)] font-semibold leading-[1.15] text-white"
        style="max-width: 640px;"
      >
        {headline}
      </h1>

      {role && (
        <p class="text-base font-medium text-white/60" style="max-width: 560px;">
          {role}
        </p>
      )}

      {body && (
        <p class="text-lg leading-relaxed text-white/70" style="max-width: 560px;">
          {body}
        </p>
      )}
    </div>
  </div>
</section>
