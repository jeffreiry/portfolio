---
interface Props {
  headline: string;
  role?: string;
  body?: string;
  contactLabel?: string;
  contactHref?: string;
}

const {
  headline,
  role,
  body,
  contactLabel = 'Get in touch →',
  contactHref = 'mailto:jfreiry@gmail.com',
} = Astro.props;
---

<section class="w-full px-6 pt-6">
  <div
    class="relative mx-auto w-full max-w-[1200px] overflow-hidden rounded-[32px] bg-neutral-700/90 px-8 pb-16 pt-40 md:px-16"
  >
    <div class="flex flex-col gap-5">
      <h1
        class="font-display text-[clamp(32px,5vw,60px)] font-semibold leading-[1.15] text-white"
        style="max-width: 640px;"
      >
        {headline}
      </h1>

      {role && (
        <p class="text-base font-medium text-white/60" style="max-width: 560px;">
          {role}
        </p>
      )}

      {body && (
        <p class="text-lg leading-relaxed text-white/70" style="max-width: 560px;">
          {body}
        </p>
      )}

      <a
        href={contactHref}
        class="mt-2 inline-flex w-fit items-center gap-1.5 rounded-full bg-white/10 px-5 py-2.5 text-sm font-medium text-white/90 transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-700"
      >
        {contactLabel}
      </a>
    </div>
  </div>
</section>
