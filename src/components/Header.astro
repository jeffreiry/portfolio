---
import ThemeToggle from './ThemeToggle.svelte';

interface Props {
  lang?: 'en' | 'pt';
  currentPath?: string;
}

const { lang = 'en', currentPath = '/' } = Astro.props;

const isEn = lang === 'en';

const homeHref    = isEn ? '/' : '/pt/';
const aboutHref   = isEn ? '/#about'   : '/pt/#about';
const casesHref   = isEn ? '/#cases'   : '/pt/#cases';
const contactHref = isEn ? '/#contact' : '/pt/#contact';

const switchLangHref = isEn
  ? `/pt${currentPath === '/' ? '' : currentPath}`
  : currentPath.replace(/^\/pt/, '') || '/';
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full"
>
  <div class="mx-auto relative flex max-w-[1200px] items-center justify-between px-6">

    <!-- Logo — some ao scrollar -->
    <a
      id="header-logo"
      href={homeHref}
      class="relative z-10 transition-opacity hover:opacity-70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
      style="--tw-ring-color: var(--color-cha-mate);"
      aria-label="Jeferson Freiry — home"
    >
      <img src="/jeferson-black.png" alt="Jeferson Freiry" class="logo-black" style="height: 80px; width: auto; display: block;" />
      <img src="/jeferson-white.png" alt="Jeferson Freiry" class="logo-white" style="height: 80px; width: auto; display: none;" />
    </a>

    <!-- Nav pill — centralizado absolutamente -->
    <nav
      class="nav-pill absolute left-1/2 -translate-x-1/2 flex items-center gap-1"
      style="border-radius: 999px; border: 0.5px solid var(--color-border); padding: 5px 6px; backdrop-filter: blur(12px); background: color-mix(in srgb, var(--color-page-bg) 85%, transparent);"
      aria-label="Main navigation"
    >
      <a href={aboutHref} class="nav-link rounded-full px-3 py-1.5 text-[12px] font-medium transition-colors"
        style="color: var(--color-muted); font-family: var(--font-body); letter-spacing: 0.02em;">
        {isEn ? 'About' : 'Sobre'}
      </a>
      <a href={casesHref} class="nav-link rounded-full px-3 py-1.5 text-[12px] font-medium transition-colors"
        style="color: var(--color-muted); font-family: var(--font-body); letter-spacing: 0.02em;">
        Cases
      </a>
      <a href={contactHref} class="nav-link rounded-full px-3 py-1.5 text-[12px] font-medium transition-colors"
        style="color: var(--color-muted); font-family: var(--font-body); letter-spacing: 0.02em;">
        {isEn ? 'Contact' : 'Contato'}
      </a>
    </nav>

    <!-- Controls — direita: dois pills separados -->
    <div class="controls-right relative z-10 flex items-center gap-2">

      <!-- Theme toggle em pill próprio -->
      <div
        class="theme-pill flex items-center justify-center"
        style="border-radius: 999px; border: 0.5px solid var(--color-border); padding: 5px; backdrop-filter: blur(12px); background: color-mix(in srgb, var(--color-page-bg) 85%, transparent);"
      >
        <ThemeToggle client:load />
      </div>

      <!-- Language switch — pill com indicador de seleção -->
      <div
        class="lang-switch flex items-center"
        role="group"
        aria-label={isEn ? 'Language selection' : 'Seleção de idioma'}
        style="border-radius: 999px; border: 0.5px solid var(--color-border); padding: 5px 6px; backdrop-filter: blur(12px); background: color-mix(in srgb, var(--color-page-bg) 85%, transparent);"
      >
        {isEn
          ? <span class="lang-option lang-active" aria-current="page">EN</span>
          : <a href={switchLangHref} class="lang-option lang-inactive" hreflang="en" aria-label="Switch to English">EN</a>
        }
        {!isEn
          ? <span class="lang-option lang-active" aria-current="page">PT</span>
          : <a href={switchLangHref} class="lang-option lang-inactive" hreflang="pt" aria-label="Mudar para Português">PT</a>
        }
      </div>

    </div>

  </div>
</header>

<style>
  html[data-theme="dark"] .logo-black { display: none !important; }
  html[data-theme="dark"] .logo-white { display: block !important; }

  /* Header: altura via padding, comprime ao scrollar */
  #site-header {
    padding-top: 16px;
    padding-bottom: 16px;
    transition: padding 0.35s cubic-bezier(0.16,1,0.3,1);
  }
  #site-header.scrolled {
    padding-top: 8px;
    padding-bottom: 8px;
  }

  /* Logo: fade + slide para cima ao scrollar */
  #header-logo {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  #site-header.scrolled #header-logo {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-6px);
  }

  /* Hover nos links de nav */
  .nav-link:hover {
    background: color-mix(in srgb, var(--color-cha-mate) 8%, transparent);
    color: var(--color-cha-mate) !important;
  }

  /* Focus visível nos links de nav */
  .nav-link:focus-visible {
    outline: 2px solid var(--color-cha-mate);
    outline-offset: 2px;
    background: color-mix(in srgb, var(--color-cha-mate) 8%, transparent);
  }

  /* Sombra suave nas pills ao scrollar */
  #site-header.scrolled .nav-pill,
  #site-header.scrolled .theme-pill,
  #site-header.scrolled .lang-switch {
    box-shadow: 0 2px 16px -4px rgba(0,0,0,0.10);
  }

  /* Language switch — opções (mesma altura que os nav-links) */
  .lang-option {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 12px;
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Idioma ativo — pill interno preenchido */
  .lang-active {
    background: var(--color-cha-mate);
    color: var(--color-page-bg);
  }

  /* Idioma inativo — link discreto */
  .lang-inactive {
    color: var(--color-faint);
    transition: color 0.15s;
  }

  .lang-inactive:hover {
    color: var(--color-cha-mate);
  }

  .lang-inactive:focus-visible {
    outline: 2px solid var(--color-cha-mate);
    outline-offset: 2px;
    border-radius: 999px;
  }

  /* Mobile (≤809px): ocultar nav pill, reduzir logo */
  @media (max-width: 809px) {
    .nav-pill {
      display: none;
    }
    #header-logo img {
      height: 52px !important;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (!header) return;
    header.classList.toggle('scrolled', window.scrollY > 40);
  }, { passive: true });
</script>
