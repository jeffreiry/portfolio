---
import ThemeToggle from './ThemeToggle.svelte';

interface Props {
  lang?: 'en' | 'pt';
  currentPath?: string;
}

const { lang = 'en', currentPath = '/' } = Astro.props;

const isEn = lang === 'en';

const homeHref    = isEn ? '/' : '/pt/';
const aboutHref   = isEn ? '/#about'   : '/pt/#about';
const careerHref  = isEn ? '/#career'  : '/pt/#career';
const casesHref   = isEn ? '/#cases'   : '/pt/#cases';
const contactHref = isEn ? '/#contact' : '/pt/#contact';

const switchLangHref = isEn
  ? `/pt${currentPath === '/' ? '' : currentPath}`
  : currentPath.replace(/^\/pt/, '') || '/';
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full transition-colors duration-200"
  style="background: color-mix(in srgb, var(--color-page-bg) 92%, transparent); backdrop-filter: blur(10px); border-bottom: 0.5px solid var(--color-border);"
>
  <div class="mx-auto flex h-[52px] max-w-[1200px] items-center justify-between px-5">

    <!-- Logo -->
    <a
      href={homeHref}
      class="font-display text-[15px] tracking-[0.04em] transition-opacity hover:opacity-70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
      style="color: var(--color-cha-mate); --tw-ring-color: var(--color-cha-mate);"
      aria-label="Jeferson Freiry — home"
    >
      JF
    </a>

    <!-- Nav -->
    <nav class="flex items-center gap-5" aria-label="Main navigation">
      <a
        href={aboutHref}
        class="text-[12px] font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-1"
        style="color: var(--color-muted); font-family: var(--font-body); letter-spacing: 0.02em; --tw-ring-color: var(--color-cha-mate);"
      >
        {isEn ? 'About' : 'Sobre'}
      </a>

      <a
        href={careerHref}
        class="text-[12px] font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-1"
        style="color: var(--color-muted); font-family: var(--font-body); letter-spacing: 0.02em; --tw-ring-color: var(--color-cha-mate);"
      >
        {isEn ? 'Career' : 'Carreira'}
      </a>

      <a
        href={casesHref}
        class="text-[12px] font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-1"
        style="color: var(--color-muted); font-family: var(--font-body); letter-spacing: 0.02em; --tw-ring-color: var(--color-cha-mate);"
      >
        Cases
      </a>

      <a
        href={contactHref}
        class="text-[12px] font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-1"
        style="color: var(--color-muted); font-family: var(--font-body); letter-spacing: 0.02em; --tw-ring-color: var(--color-cha-mate);"
      >
        {isEn ? 'Contact' : 'Contato'}
      </a>

      <!-- Separador -->
      <span class="h-3.5 w-px" style="background: var(--color-border);" aria-hidden="true" />

      <!-- Theme toggle -->
      <ThemeToggle client:load />

      <!-- Language switcher -->
      <div class="flex items-center gap-1 text-[11px] font-medium" style="font-family: var(--font-body);">
        <span
          style={isEn ? 'color: var(--color-cha-mate);' : 'color: var(--color-faint);'}
          aria-label={isEn ? 'Current language: English' : undefined}
        >
          EN
        </span>
        <span style="color: var(--color-border);">·</span>
        <a
          href={switchLangHref}
          class="transition-colors hover:opacity-80 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-offset-1"
          style={!isEn
            ? 'color: var(--color-cha-mate); --tw-ring-color: var(--color-cha-mate);'
            : 'color: var(--color-faint); --tw-ring-color: var(--color-cha-mate);'}
          aria-label={isEn ? 'Mudar para Português' : 'Switch to English'}
          hreflang={isEn ? 'pt' : 'en'}
        >
          PT
        </a>
      </div>
    </nav>
  </div>

  <!-- Accent bar Jambu — aparece ao fazer scroll -->
  <div
    id="header-accent"
    class="absolute bottom-0 left-0 right-0 h-[2px] origin-left scale-x-0 transition-transform duration-300"
    style="background-color: var(--color-jambu);"
    aria-hidden="true"
  />
</header>

<script>
  const accent = document.getElementById('header-accent');
  window.addEventListener('scroll', () => {
    if (!accent) return;
    accent.style.transform = window.scrollY > 20 ? 'scaleX(1)' : 'scaleX(0)';
  }, { passive: true });
</script>
