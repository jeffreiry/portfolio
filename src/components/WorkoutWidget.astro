---
interface Props {
  lang: 'en' | 'pt';
}
const { lang } = Astro.props;

let totalVolume: number | null = null;
let count = 0;

try {
  const res = await fetch('https://painel-saude-zeta.vercel.app/api/weekly-workout');
  if (res.ok) {
    const data = await res.json();
    if (data) { totalVolume = data.total_volume_kg; count = data.count; }
  }
} catch { /* skip */ }

const title    = lang === 'pt' ? 'Academia esta semana' : 'Gym This Week';
const workouts = lang === 'pt'
  ? `${count} ${count === 1 ? 'treino' : 'treinos'}`
  : `${count} ${count === 1 ? 'workout' : 'workouts'}`;
const syncing  = lang === 'pt' ? 'Sincroniza com Hevy' : 'Syncing with Hevy';
---

{totalVolume !== null && (
  <div class="workout-widget" aria-label={`${title}: ${totalVolume} kg`}>
    <div class="workout-widget__top">
      <span class="workout-widget__title">{title}</span>
      <!-- Hevy logo approximation -->
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="workout-widget__logo">
        <path d="M5 8 C5 5.8 6.8 4 9 4 L9 4 C9 6.2 7.2 8 5 8Z" fill="currentColor"/>
        <path d="M19 8 C16.8 8 15 6.2 15 4 L15 4 C17.2 4 19 5.8 19 8Z" fill="currentColor"/>
        <path d="M5 16 C7.2 16 9 17.8 9 20 L9 20 C6.8 20 5 18.2 5 16Z" fill="currentColor"/>
        <path d="M19 16 C19 18.2 17.2 20 15 20 L15 20 C15 17.8 16.8 16 19 16Z" fill="currentColor"/>
        <rect x="4" y="7" width="2" height="10" rx="1" fill="currentColor"/>
        <rect x="18" y="7" width="2" height="10" rx="1" fill="currentColor"/>
        <rect x="8" y="11" width="8" height="2" rx="1" fill="currentColor"/>
      </svg>
    </div>

    <div class="workout-widget__number">
      {totalVolume?.toLocaleString('pt-BR')}<span class="workout-widget__unit"> kg</span>
    </div>

    <div class="workout-widget__bottom">
      <span class="workout-widget__count">{workouts}</span>
      <span class="workout-widget__sync">{syncing}</span>
    </div>
  </div>
)}

<style>
  .workout-widget {
    background: var(--color-surface);
    border-radius: 16px;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .workout-widget__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .workout-widget__logo {
    color: var(--color-ink);
    flex-shrink: 0;
  }

  .workout-widget__title {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.2;
  }

  .workout-widget__number {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 48px;
    font-weight: 800;
    line-height: 1;
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }

  .workout-widget__unit {
    font-size: 20px;
    font-weight: 700;
  }

  .workout-widget__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .workout-widget__count {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-ink);
  }

  .workout-widget__sync {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-muted);
    white-space: nowrap;
  }
</style>
