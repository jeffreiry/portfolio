---
interface Props {
  lang: 'en' | 'pt';
}
const { lang } = Astro.props;

let totalHours: number | null = null;
let count = 0;

try {
  const res = await fetch('https://painel-saude-zeta.vercel.app/api/monthly-workout');
  if (res.ok) {
    const data = await res.json();
    if (data) { totalHours = data.total_hours; count = data.count; }
  }
} catch { /* skip */ }

const title    = lang === 'pt' ? 'Academia este mês' : 'Gym This Month';
const workouts = lang === 'pt'
  ? `${count} ${count === 1 ? 'treino' : 'treinos'}`
  : `${count} ${count === 1 ? 'workout' : 'workouts'}`;
const syncing  = lang === 'pt' ? 'Sincroniza com Hevy' : 'Syncing with Hevy';
---

{totalHours !== null && (
  <div class="workout-widget" aria-label={`${title}: ${totalHours}h`}>
    <div class="workout-widget__top">
      <span class="workout-widget__title">{title}</span>
      <img src="/logos/hevy.png" alt="Hevy" width="28" height="28" class="workout-widget__logo" />
    </div>

    <div class="workout-widget__number">
      {totalHours}<span class="workout-widget__unit">h</span>
    </div>

    <div class="workout-widget__bottom">
      <span class="workout-widget__count">{workouts}</span>
      <span class="workout-widget__sync">
        <span class="workout-widget__dot" aria-hidden="true"></span>
        {syncing}
      </span>
    </div>
  </div>
)}

<style>
  .workout-widget {
    background: #fafafa;
    border-radius: 16px;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .workout-widget__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .workout-widget__logo {
    object-fit: contain;
    flex-shrink: 0;
  }

  :global(html[data-theme="dark"]) .workout-widget {
    background: var(--color-surface);
  }

  :global(html[data-theme="dark"]) .workout-widget__logo {
    filter: brightness(0) invert(1);
  }

  .workout-widget__title {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.2;
  }

  .workout-widget__number {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 48px;
    font-weight: 800;
    line-height: 1;
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }

  .workout-widget__unit {
    font-size: 20px;
    font-weight: 700;
  }

  .workout-widget__bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .workout-widget__count {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-ink);
  }

  .workout-widget__dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    animation: pulse-dot 2s ease-in-out infinite;
    flex-shrink: 0;
    margin-right: 4px;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.75); }
  }

  .workout-widget__sync {
    display: flex;
    align-items: center;
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-muted);
    white-space: nowrap;
  }
</style>
