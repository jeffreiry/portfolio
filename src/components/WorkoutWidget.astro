---
interface Props {
  lang: 'en' | 'pt';
}

const { lang } = Astro.props;

let volumeKg: number | null = null;
let dateLabel: string | null = null;
let workoutTitle: string | null = null;

try {
  const res = await fetch('https://painel-saude-zeta.vercel.app/api/last-workout');
  if (res.ok) {
    const data = await res.json();
    if (data) {
      volumeKg = data.volume_kg;
      workoutTitle = data.title?.split('·')[1]?.trim() ?? data.title;

      const date = new Date(data.date + 'T00:00:00');
      dateLabel = date.toLocaleDateString(lang === 'pt' ? 'pt-BR' : 'en-US', {
        day: 'numeric',
        month: 'short',
      });
    }
  }
} catch {
  // silently skip if fetch fails at build time
}

const liveLabel    = lang === 'pt' ? 'atualiza toda noite' : 'updates nightly';
const workoutLabel = lang === 'pt' ? 'Último treino' : 'Last workout';
---

{volumeKg !== null && (
  <div
    data-animate
    style="--animate-delay: 280ms"
    class="workout-widget w-full"
    aria-label={lang === 'pt' ? `Último treino: ${volumeKg} kg` : `Last workout: ${volumeKg} kg`}
  >
    <!-- Header row -->
    <div class="workout-widget__header">
      <div class="workout-widget__header-left">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6.5 6.5h1.5v11H6.5zM16 6.5h1.5v11H16z" fill="#f97316"/>
          <rect x="4" y="10" width="4" height="4" rx="1" fill="#f97316"/>
          <rect x="16" y="10" width="4" height="4" rx="1" fill="#f97316"/>
          <rect x="8" y="9" width="8" height="6" rx="1" fill="#f97316" opacity="0.5"/>
        </svg>
        <span class="workout-widget__label">{workoutLabel}</span>
      </div>
      <div class="workout-widget__live">
        <span class="workout-widget__dot" aria-hidden="true"></span>
        <span class="workout-widget__live-label">{liveLabel}</span>
      </div>
    </div>

    <!-- Data row -->
    <div class="workout-widget__data">
      <div class="workout-widget__stat">
        <span class="workout-widget__number">{volumeKg}</span>
        <span class="workout-widget__unit">kg</span>
      </div>

      {dateLabel && (
        <>
          <div class="workout-widget__divider" aria-hidden="true"></div>
          <div class="workout-widget__stat workout-widget__stat--secondary">
            <span class="workout-widget__value">{dateLabel}</span>
          </div>
        </>
      )}

      {workoutTitle && (
        <>
          <div class="workout-widget__divider" aria-hidden="true"></div>
          <div class="workout-widget__stat workout-widget__stat--secondary">
            <span class="workout-widget__value">{workoutTitle}</span>
          </div>
        </>
      )}
    </div>
  </div>
)}

<style>
  .workout-widget {
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 16px;
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .workout-widget__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .workout-widget__header-left {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .workout-widget__label {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #555;
  }

  .workout-widget__live {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .workout-widget__dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    animation: pulse-dot 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.75); }
  }

  .workout-widget__live-label {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 10px;
    font-weight: 400;
    color: #3a3a3a;
    white-space: nowrap;
  }

  .workout-widget__data {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .workout-widget__stat {
    display: flex;
    align-items: baseline;
    gap: 3px;
  }

  .workout-widget__number {
    font-family: var(--font-display, 'Cactus Regular', serif);
    font-size: 36px;
    font-weight: 400;
    color: #ffffff;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .workout-widget__unit {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 13px;
    font-weight: 500;
    color: #f97316;
  }

  .workout-widget__divider {
    width: 1px;
    height: 28px;
    background: #2e2e2e;
    flex-shrink: 0;
  }

  .workout-widget__stat--secondary {
    align-items: center;
  }

  .workout-widget__value {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 12px;
    font-weight: 400;
    color: #666;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 120px;
  }
</style>
