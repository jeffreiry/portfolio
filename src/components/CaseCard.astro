---
interface Props {
  title: string;
  summary: string;
  slug: string;
  role: string;
  year: number;
  tags: string[];
  accent?: string;
  thumbnail?: string;
  bgImage?: string;
  cover?: string;
  lang?: string;
}

const {
  title,
  summary,
  slug,
  role,
  year,
  tags,
  accent = '#e8e4dc',
  thumbnail,
  bgImage,
  cover,
  lang = 'en',
} = Astro.props;

const base = lang === 'en' ? '' : '/pt';
const href = `${base}/work/${slug}`;

const placeholders = [
  'https://images.unsplash.com/photo-1551288049-bebda4e38f71?fm=jpg&w=800&q=80&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1460925895917-afdab827c52f?fm=jpg&w=800&q=80&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1526628953301-3e589a6a8b74?fm=jpg&w=800&q=80&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1542744173-05336fcc7ad4?fm=jpg&w=800&q=80&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1666875753105-c63a6f3bdc86?fm=jpg&w=800&q=80&auto=format&fit=crop',
];
const hash = slug.split('').reduce((acc, c) => acc + c.charCodeAt(0), 0);
const imgSrc = thumbnail ?? bgImage ?? cover ?? placeholders[hash % placeholders.length];
---

<a
  href={href}
  class="group flex flex-col overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-4"
  style={`border-radius: var(--radius-card); --tw-ring-color: var(--text-heading); background-color: var(--bg-surface); border: 0.5px solid var(--border-default); transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), box-shadow 0.35s cubic-bezier(0.16,1,0.3,1);`}
  onmouseover="this.style.transform='translateY(-6px)';this.style.boxShadow='0 20px 48px -8px rgba(0,0,0,0.18)'"
  onmouseout="this.style.transform='';this.style.boxShadow=''"
  onfocus="this.style.transform='translateY(-6px)';this.style.boxShadow='0 20px 48px -8px rgba(0,0,0,0.18)'"
  onblur="this.style.transform='';this.style.boxShadow=''"
>
  <!-- Imagem — zona superior, altura fixa -->
  <div class="relative w-full overflow-hidden" style="height: 200px;">
    <img
      src={imgSrc}
      alt={title}
      class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]"
      loading="lazy"
    />
    <!-- Accent bar Jambu no bottom da imagem -->
    <div
      class="absolute bottom-0 left-0 right-0 pointer-events-none"
      style="height: 3px; background-color: var(--accent-deco);"
    />
  </div>

  <!-- Conteúdo — zona inferior, fundo sólido -->
  <div class="flex flex-col gap-3 p-5">
    <div class="flex items-center gap-2">
      <span
        class="text-caption uppercase tracking-[var(--tracking-caption)]"
        style="color: var(--text-subtle); font-weight: 600; font-family: var(--font-body);"
      >
        {year}
      </span>
    </div>

    <h3
      class="font-display"
      style="font-size: var(--text-card); line-height: var(--leading-heading); color: var(--text-heading);"
    >
      {title}
    </h3>

    <p
      class="line-clamp-2 leading-relaxed"
      style="font-size: var(--text-xs); font-weight: 400; font-family: var(--font-body); color: var(--text-secondary); min-height: calc(var(--text-xs) * var(--leading-normal) * 2);"
    >
      {summary}
    </p>

    <div class="flex flex-wrap justify-center gap-1.5">
      {tags.slice(0, 3).map((tag) => (
        <span
          class="rounded-full px-2.5 py-1 text-caption font-medium"
          style="background: var(--bg-surface-alt); color: var(--text-secondary); font-family: var(--font-body);"
        >
          {tag}
        </span>
      ))}
    </div>

    <div class="flex justify-center mt-3 lg:hidden">
      <span
        class="inline-flex items-center justify-center"
        style="background: transparent; border: 1.5px solid var(--accent-text); border-radius: var(--radius-pill); padding: 9px 28px; font-size: 12px; font-weight: 600; font-family: var(--font-body); color: var(--accent-text); letter-spacing: 0.02em;"
      >
        {lang === 'en' ? 'View case →' : 'Ver case →'}
      </span>
    </div>
  </div>
</a>
