---
interface Props {
  title: string;
  summary: string;
  slug: string;
  role: string;
  year: number;
  tags: string[];
  accent?: string;
  thumbnail?: string;
  cover?: string;
  lang?: string;
}

const {
  title,
  summary,
  slug,
  role,
  year,
  tags,
  accent = '#e8e4dc',
  thumbnail,
  cover,
  lang = 'en',
} = Astro.props;

const base = lang === 'en' ? '' : '/pt';
const href = `${base}/work/${slug}`;

const placeholders = [
  'https://images.unsplash.com/photo-1551288049-bebda4e38f71?fm=jpg&w=800&q=80&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1460925895917-afdab827c52f?fm=jpg&w=800&q=80&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1526628953301-3e589a6a8b74?fm=jpg&w=800&q=80&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1542744173-05336fcc7ad4?fm=jpg&w=800&q=80&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1666875753105-c63a6f3bdc86?fm=jpg&w=800&q=80&auto=format&fit=crop',
];
const hash = slug.split('').reduce((acc, c) => acc + c.charCodeAt(0), 0);
const imgSrc = thumbnail ?? cover ?? placeholders[hash % placeholders.length];
---

<a
  href={href}
  class="group flex flex-col overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-4"
  style={`border-radius: var(--radius-card); --tw-ring-color: var(--color-cha-mate); background-color: var(--color-surface); border: 0.5px solid var(--color-border); transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), box-shadow 0.35s cubic-bezier(0.16,1,0.3,1);`}
  onmouseover="this.style.transform='translateY(-6px)';this.style.boxShadow='0 20px 48px -8px rgba(0,0,0,0.18)'"
  onmouseout="this.style.transform='';this.style.boxShadow=''"
  onfocus="this.style.transform='translateY(-6px)';this.style.boxShadow='0 20px 48px -8px rgba(0,0,0,0.18)'"
  onblur="this.style.transform='';this.style.boxShadow=''"
>
  <!-- Imagem — zona superior, altura fixa -->
  <div class="relative w-full overflow-hidden" style="height: 200px;">
    <img
      src={imgSrc}
      alt={title}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
      loading="lazy"
    />
    <!-- Accent bar Jambu no bottom da imagem -->
    <div
      class="absolute bottom-0 left-0 right-0 pointer-events-none"
      style="height: 3px; background-color: var(--color-jambu);"
    />
  </div>

  <!-- Conteúdo — zona inferior, fundo sólido -->
  <div class="flex flex-col gap-2 p-5 pb-6">
    <div class="flex items-center justify-between gap-2">
      <span
        class="text-[10px] uppercase tracking-[0.09em]"
        style="color: var(--color-faint); font-weight: 600; font-family: var(--font-body);"
      >
        {role}
      </span>
      <span
        class="text-[10px]"
        style="color: var(--color-faint); font-weight: 500; font-family: var(--font-body);"
      >
        {year}
      </span>
    </div>

    <h2
      class="font-display"
      style="font-size: 24px; line-height: 1.1; color: var(--color-cha-mate);"
    >
      {title}
    </h2>

    <p
      class="line-clamp-2 leading-relaxed"
      style="font-size: 13px; font-weight: 400; font-family: var(--font-body); color: var(--color-muted);"
    >
      {summary}
    </p>

    <div class="mt-2 flex items-end justify-between gap-2">
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((tag) => (
          <span
            class="rounded-full px-2.5 py-1 text-[10px] font-medium"
            style="background: var(--color-surface-2); color: var(--color-muted); font-family: var(--font-body);"
          >
            {tag}
          </span>
        ))}
      </div>
      <span
        class="shrink-0 text-[11px] font-medium tracking-wide"
        style="color: var(--color-jambu); font-family: var(--font-body);"
      >
        {lang === 'en' ? 'View case →' : 'Ver case →'}
      </span>
    </div>
  </div>
</a>
