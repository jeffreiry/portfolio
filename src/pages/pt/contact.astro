---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactForm from '../../components/ContactForm.svelte';

const whatsappHref = 'https://wa.me/5551984741888';
---

<Base
  title="Contato — Jeferson Freiry"
  description="Entre em contato com Jeferson Freiry — Product Designer Sênior. Envie uma mensagem ou fale pelo WhatsApp."
  lang="pt"
>
  <Header lang="pt" currentPath="/pt/contact" />

  <main class="mx-auto w-full max-w-[1200px] px-6 py-16">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">

      <!-- Esquerda: copy -->
      <div class="flex flex-col gap-6 max-w-[480px]">
        <div class="flex flex-col gap-3">
          <h1 class="font-display text-4xl font-bold" style="color: var(--color-cha-mate);">
            Vamos conversar
          </h1>
          <p class="text-lg leading-relaxed" style="color: var(--color-muted);">
            Estou aberto a posições sênior de product design, projetos de consultoria e conversas sobre UX e IA.
          </p>
        </div>

        <div class="flex flex-col gap-4 pt-2">
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--color-faint, #b0a8a0);">E-mail</span>
            <a
              href="mailto:jfreiry@gmail.com"
              class="text-base font-medium transition-opacity hover:opacity-70"
              style="color: var(--color-cha-mate);"
            >
              jfreiry@gmail.com
            </a>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--color-faint, #b0a8a0);">LinkedIn</span>
            <a
              href="https://linkedin.com/in/jefersonfreiry"
              target="_blank"
              rel="noopener noreferrer"
              class="text-base font-medium transition-opacity hover:opacity-70"
              style="color: var(--color-cha-mate);"
            >
              linkedin.com/in/jefersonfreiry
            </a>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--color-faint, #b0a8a0);">Localização</span>
            <span class="text-base" style="color: var(--color-muted);">Porto Alegre, RS · Brasil</span>
          </div>
        </div>
      </div>

      <!-- Direita: formulário (ilha Svelte) -->
      <div>
        <ContactForm lang="pt" {whatsappHref} client:load />
      </div>

    </div>
  </main>

  <Footer lang="pt" />
</Base>
