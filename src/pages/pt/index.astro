---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import CaseCard from '../../components/CaseCard.astro';

const cases = [
  {
    title: 'Assistente de IA para Conhecimento Corporativo',
    summary: 'Escalou um MVP de assistente com IA onde a rastreabilidade de fontes se tornou o produto central.',
    slug: 'enterprise-ai-assistant',
    role: 'Product Designer',
    year: 2025,
    tags: ['Enterprise', 'IA conversacional', 'Design de informação'],
    accent: '#efedff',
  },
  {
    title: 'Plataforma de Otimização de Capacidade de Carga',
    summary: 'Um timeline visual transformou planilhas dispersas em uma plataforma que revela oportunidades de carga em tempo real.',
    slug: 'shipping-capacity-platform',
    role: 'Product Designer',
    year: 2025,
    tags: ['Enterprise', 'DataViz', 'Simulação operacional'],
    accent: '#e1f5fe',
  },
  {
    title: 'Arezzo&Co · Sistema de Anúncios',
    summary: 'Um sistema, três jornadas — arquitetura de informação por papel para Marketing, Gestores e Lojistas.',
    slug: 'arezzo-ad-management',
    role: 'UX · UI · Pesquisa',
    year: 2023,
    tags: ['Retail', 'Multi-perfil', 'Design de sistema'],
    accent: '#ecf0f3',
  },
  {
    title: 'Cartela de Cores',
    summary: 'Transformou um PDF estático de consultoria de coloração em um sistema que pontua peças do guarda-roupa em tempo real.',
    slug: 'cartela-cores',
    role: 'Product Designer',
    year: 2024,
    tags: ['Web app', 'Algoritmo de cor', 'Design system'],
    accent: '#fff7ef',
  },
];
---

<Base title="Jeferson Freiry — Product Designer" lang="pt">
  <Header lang="pt" currentPath="/" />

  <main class="flex flex-col gap-6 pb-24">
    <Hero
      headline="Jeferson Freiry"
      role="Senior Product Designer especializado em sistemas enterprise complexos."
      body="Eu projeto produtos orientados a dados e plataformas com IA que ajudam organizações a acessar conhecimento, otimizar fluxos de trabalho e tomar melhores decisões."
    />

    <!-- Sobre -->
    <section class="mx-auto w-full max-w-[1200px] px-6 py-10">
      <div class="flex flex-col gap-4 max-w-[720px]">
        <h2 class="font-display text-2xl font-semibold text-neutral-900">Sobre</h2>
        <p class="text-lg leading-relaxed text-neutral-600">
          Sou Product Designer com mais de 5 anos de experiência em produtos digitais, após quase uma década atuando em marketing e comunicação.
        </p>
        <p class="text-lg leading-relaxed text-neutral-600">
          Meu trabalho é focado em ambientes enterprise complexos, onde usuários lidam com grandes volumes de informação e processos técnicos. Especializo-me em transformar sistemas complexos em experiências claras e utilizáveis.
        </p>
      </div>
    </section>

    <!-- Carreira -->
    <section class="mx-auto w-full max-w-[1200px] px-6 py-10">
      <div class="flex flex-col gap-6">
        <h2 class="font-display text-2xl font-semibold text-neutral-900">Carreira</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {[
            { company: 'eSales', role: 'Product Designer', period: '2020 — 2021', description: 'Liderou a descoberta de um novo produto financeiro e melhorou plataformas digitais centrais.' },
            { company: 'Intelipost', role: 'UX Researcher', period: '2021 — 2022', description: 'Mapeou a jornada end-to-end do usuário desde a aquisição do produto até o uso diário.' },
            { company: 'CWI', role: 'Product Designer', period: '2022 — 2023', description: 'Projetou produtos digitais para grandes empresas nas fases de discovery e delivery.' },
            { company: 'ilegra', role: 'Product Designer', period: '2023 — 2025', description: 'Entregou design de produto enterprise em engajamentos de consultoria.' },
            { company: 'Braskem', role: 'Product Designer', period: '2025 — Presente', description: 'Projetando plataformas enterprise e sistemas de conhecimento com IA.' },
          ].map((item) => (
            <div class="flex flex-col gap-2 rounded-2xl bg-neutral-50 p-5">
              <span class="text-sm font-semibold text-neutral-400">{item.company}</span>
              <span class="font-display text-lg font-semibold text-neutral-900">{item.role}</span>
              <span class="text-sm text-neutral-400">{item.period}</span>
              <p class="text-sm leading-relaxed text-neutral-600">{item.description}</p>
            </div>
          ))}
        </div>
        <p class="text-sm text-neutral-400">
          Para uma visão completa, acesse meu <a href="https://linkedin.com/in/jeffreiry" class="text-neutral-700 underline underline-offset-2" target="_blank" rel="noopener">LinkedIn →</a>
        </p>
      </div>
    </section>

    <!-- Formação -->
    <section class="mx-auto w-full max-w-[1200px] px-6 py-10">
      <div class="flex flex-col gap-6">
        <h2 class="font-display text-2xl font-semibold text-neutral-900">Formação</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-1 rounded-2xl bg-neutral-50 p-5">
            <span class="font-display text-base font-semibold text-neutral-900">Bacharelado em Publicidade e Propaganda</span>
            <span class="text-sm text-neutral-400">Universidade Feevale</span>
          </div>
          <div class="flex flex-col gap-1 rounded-2xl bg-neutral-50 p-5">
            <span class="font-display text-base font-semibold text-neutral-900">Pós-graduação em User Experience</span>
            <span class="text-sm text-neutral-400">Uniritter</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Grade de cases -->
    <section class="mx-auto w-full max-w-[1200px] px-6">
      <div class="grid gap-6 sm:grid-cols-2">
        {cases.map((c) => (
          <CaseCard {...c} lang="pt" />
        ))}
      </div>
    </section>
  </main>

  <Footer lang="pt" />
</Base>
