---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import CaseCard from '../../components/CaseCard.astro';
import ContactForm from '../../components/ContactForm.svelte';
import RunWidget from '../../components/RunWidget.astro';
import WorkoutWidget from '../../components/WorkoutWidget.astro';
import { getCollection } from 'astro:content';
import { detectCardImage } from '../../utils/cover';

const allCases = await getCollection('casesPt', ({ data }) => !data.draft && !data.protected);
const cases = allCases.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const whatsappHref = 'https://wa.me/5551984741888';
---

<Base
  title="Jeferson Freiry — Product Designer"
  description="Senior Product Designer especializado em sistemas enterprise complexos. Projeto produtos orientados a dados e plataformas com IA que ajudam organizações a acessar conhecimento, otimizar fluxos e tomar melhores decisões."
  lang="pt"
>
  <Header lang="pt" currentPath="/" />

  <main id="main-content" class="flex flex-col gap-6 pb-24">
    <Hero
      headline="Jeferson Freiry"
      role="Product Designer Sênior · UX & Sistemas com IA"
      body="Projeto produtos orientados a dados e plataformas integradas com IA que transformam processos enterprise complexos em experiências claras e utilizáveis — da descoberta à entrega."
      contactLabel="Entrar em contato →"
      contactHref="#contact"
      bgVideo="/Gh011011.mp4"
      bgImage="https://images.unsplash.com/photo-1742647338510-53378767ecd7?w=800&q=80"
    />

    <!-- Sobre + Carreira lado a lado -->
    <section class="mx-auto w-full max-w-[1200px] px-6 py-10">
      <div class="grid gap-16 lg:grid-cols-2 lg:gap-20">

        <!-- Sobre -->
        <div id="about" class="flex flex-col gap-4">
          <h2 data-animate class="font-display text-section font-semibold text-heading">Sobre</h2>
          <p data-animate style="--animate-delay: 80ms" class="text-lg leading-relaxed text-secondary">
            Sou Product Designer Sênior com mais de 5 anos em UX/UI e mais de 10 anos em marketing e comunicação digital — uma trajetória que molda como penso sobre marca, narrativa e contexto de negócio além da usabilidade.
          </p>
          <p data-animate style="--animate-delay: 160ms" class="text-lg leading-relaxed text-secondary">
            Meu foco atual é em sistemas enterprise e plataformas com IA: ambientes onde usuários navegam grandes volumes de informação, fluxos complexos e processos com impacto operacional real. Na Braskem, lidero práticas de UX e fluxos de design integrados com IA para plataformas de escala industrial — incluindo design critiques, onboarding de designers e entrevistas técnicas. Colaboro com frequência com stakeholders internacionais em inglês.
          </p>

          <div data-animate style="--animate-delay: 200ms" class="flex flex-wrap gap-3 pt-1">
            <a
              href="/Jeferson_Freiry_PT.pdf"
              download
              class="inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors hover:bg-surface"
              style="border-color: var(--border-default); color: var(--text-heading); font-family: var(--font-body);"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Baixe meu Currículo
            </a>
          </div>

          <!-- Formação -->
          <div class="flex flex-col gap-3 pt-2">
            <h3 data-animate style="--animate-delay: 240ms; font-family: var(--font-body); font-size: var(--text-eyebrow); font-weight: 600; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--text-subtle);">Formação</h3>
            <div class="grid gap-3 sm:grid-cols-2 items-stretch">
              <div data-animate style="--animate-delay: 280ms" class="flex flex-col gap-1 rounded-2xl bg-surface p-4 h-full">
                <span class="text-sm font-semibold text-primary">Bacharelado em Publicidade e Propaganda</span>
                <span class="text-xs text-subtle">Universidade Feevale · 2016</span>
              </div>
              <div data-animate style="--animate-delay: 320ms" class="flex flex-col gap-1 rounded-2xl bg-surface p-4 h-full">
                <span class="text-sm font-semibold text-primary">Especialização em User Experience</span>
                <span class="text-xs text-subtle">Uniritter · 2021</span>
              </div>
            </div>
          </div>

          <h3 data-animate style="--animate-delay: 360ms; font-family: var(--font-body); font-size: var(--text-eyebrow); font-weight: 600; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--text-subtle);">
            Outras atividades fora do trabalho
          </h3>
          <div class="grid gap-3 sm:grid-cols-2">
            <div data-animate style="--animate-delay: 400ms">
              <RunWidget lang="pt" />
            </div>
            <div data-animate style="--animate-delay: 470ms">
              <WorkoutWidget lang="pt" />
            </div>
          </div>
        </div>

        <!-- Carreira -->
        <div id="career" class="flex flex-col gap-4">
          <h2 data-animate class="font-display text-section font-semibold text-heading">Carreira</h2>
          <div class="grid flex-1 gap-3 sm:grid-cols-2" style="grid-auto-rows: 1fr;">
            {[
              { company: 'Braskem',    logo: '/logos/braskem.avif',    role: 'Product Designer', period: '2025 — Presente', description: 'Liderando práticas de UX e fluxos de design integrados com IA para plataformas de escala industrial.' },
              { company: 'ilegra',     logo: '/logos/ilegra.png',      role: 'Product Designer', period: '2023 — 2025', description: 'Design de produto enterprise e pesquisa UX em projetos industriais, financeiros e de consultoria.' },
              { company: 'CWI',        logo: '/logos/cwi.png',        role: 'Product Designer', period: '2022 — 2023', description: 'Design UX end-to-end para grandes clientes de Moda, Alimentos e Telecomunicações.' },
              { company: 'Intelipost', logo: '/logos/Intelipost.png', role: 'UX Researcher',    period: '2021 — 2022', description: 'Mapeou a jornada end-to-end do usuário desde a aquisição do produto até o uso diário.' },
              { company: 'eSales',     logo: '/logos/esales.png',      role: 'Product Designer', period: '2021', description: 'Pesquisa com usuários, mapeamento de jornadas e product discovery para soluções digitais.' },
            ].map((item, i) => (
              <div data-animate style={`--animate-delay: ${i * 70}ms`} class="flex flex-col gap-3 rounded-2xl bg-surface p-5">
                <img
                  src={item.logo}
                  alt={item.company}
                  class={`career-logo${item.opaque ? ' career-logo-opaque' : ''} h-[22px] w-[94px] object-contain object-left`}
                  loading="lazy"
                />
                <span class="text-sm font-semibold text-primary">{item.role}</span>
                <span class="text-sm text-subtle">{item.period}</span>
                <p class="text-sm leading-relaxed text-secondary">{item.description}</p>
              </div>
            ))}
            <!-- LinkedIn card sem preenchimento -->
            <a
              data-animate
              style="--animate-delay: 350ms"
              href="https://linkedin.com/in/jefersonfreiry"
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col justify-center gap-1 rounded-2xl border p-5 transition-colors hover:bg-surface"
              style="border-color: var(--border-default);"
            >
              <span class="text-sm font-semibold text-primary">Histórico completo</span>
              <span class="text-sm" style="color: var(--text-secondary);">linkedin.com/in/jefersonfreiry →</span>
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- Grade de cases -->
    <section id="cases" class="mx-auto w-full max-w-[1200px] px-6">
      <h2 data-animate class="font-display text-section font-semibold text-heading mb-4">Cases</h2>

      <!-- Barra de filtros -->
      <div data-animate style="--animate-delay: 80ms" class="filter-bar flex flex-wrap gap-2 mb-6" role="group" aria-label="Filtrar cases por categoria">
        <button class="filter-btn filter-btn--active" data-filter="all" aria-pressed="true">Todos</button>
        {["Enterprise", "AI & Automation", "UX Research", "Design System", "Branding", "Mobile", "Data & Analytics"].map(tag => (
          <button class="filter-btn" data-filter={tag} aria-pressed="false">{tag}</button>
        ))}
      </div>
      <p id="filter-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {/* Card "Confidencial" (Braskem 2025) — rascunho, não publicar ainda */}
        {false && (
        <div data-animate class="case-card-wrapper" data-tags="Enterprise,AI & Automation">
          <a
            href="#contact"
            class="group flex flex-col overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-4"
            style="border-radius: var(--radius-card); --tw-ring-color: var(--text-heading); background-color: var(--bg-surface); border: 0.5px solid var(--border-default); transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), box-shadow 0.35s cubic-bezier(0.16,1,0.3,1);"
            onmouseover="this.style.transform='translateY(-6px)';this.style.boxShadow='0 20px 48px -8px rgba(0,0,0,0.18)'"
            onmouseout="this.style.transform='';this.style.boxShadow=''"
            onfocus="this.style.transform='translateY(-6px)';this.style.boxShadow='0 20px 48px -8px rgba(0,0,0,0.18)'"
            onblur="this.style.transform='';this.style.boxShadow=''"
          >
            <div class="relative flex w-full items-center justify-center overflow-hidden" style="height: 200px; background: var(--bg-surface-alt);">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--text-subtle);" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <div class="absolute bottom-0 left-0 right-0 pointer-events-none" style="height: 3px; background-color: var(--accent-deco);" />
            </div>
            <div class="flex flex-col gap-3 p-5">
              <div class="flex items-center gap-2">
                <span class="text-caption uppercase tracking-[var(--tracking-caption)]" style="color: var(--text-subtle); font-weight: 600; font-family: var(--font-body);">2025 — Presente</span>
              </div>
              <h3 class="font-display" style="font-size: var(--text-card); line-height: var(--leading-heading); color: var(--text-heading);">Braskem · Sistemas Enterprise & IA</h3>
              <p class="line-clamp-2 leading-relaxed" style="font-size: var(--text-xs); font-weight: 400; font-family: var(--font-body); color: var(--text-secondary); min-height: calc(var(--text-xs) * var(--leading-normal) * 2);">
                Trabalho atual está sob NDA e não fica listado publicamente. Posso apresentar numa conversa.
              </p>
              <div class="flex flex-wrap justify-center gap-1.5">
                <span class="rounded-full px-2.5 py-1 text-caption font-medium" style="background: var(--bg-surface-alt); color: var(--text-primary); font-family: var(--font-body);">Confidencial</span>
              </div>
              <div class="flex justify-center mt-3 lg:hidden">
                <span class="inline-flex items-center justify-center" style="background: transparent; border: 1.5px solid var(--accent-text); border-radius: var(--radius-pill); padding: 9px 28px; font-size: 12px; font-weight: 600; font-family: var(--font-body); color: var(--accent-text); letter-spacing: 0.02em;">Entrar em contato →</span>
              </div>
            </div>
          </a>
        </div>
        )}
        {cases.map((c, i) => (
          <div data-animate style={`--animate-delay: ${i * 90}ms`} class="case-card-wrapper" data-tags={c.data.tags.join(',')}>
            <CaseCard {...c.data} cover={detectCardImage(c.data.slug) ?? c.data.cover} lang="pt" />
          </div>
        ))}
      </div>
    </section>

    <script>
      const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
      const caseCards  = document.querySelectorAll<HTMLElement>('.case-card-wrapper');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => {
            b.classList.remove('filter-btn--active');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('filter-btn--active');
          btn.setAttribute('aria-pressed', 'true');
          const filter = btn.dataset.filter!;
          let visible = 0;
          caseCards.forEach(card => {
            const tags = card.dataset.tags?.split(',') ?? [];
            const show = filter === 'all' || tags.includes(filter);
            card.style.display = show ? '' : 'none';
            if (show) visible++;
          });
          const status = document.getElementById('filter-status');
          if (status) {
            status.textContent = filter === 'all'
              ? `Mostrando todos os ${visible} cases`
              : `${visible} case${visible !== 1 ? 's' : ''} em ${filter}`;
          }
        });
      });
    </script>

    <style>
      .filter-btn {
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.04em;
        padding: 6px 14px;
        border-radius: 999px;
        border: 1px solid var(--border-default);
        color: var(--text-secondary);
        background: transparent;
        cursor: pointer;
        transition: color 0.15s, background 0.15s, border-color 0.15s;
      }
      .filter-btn:hover {
        color: var(--text-heading);
        border-color: var(--text-heading);
      }
      .filter-btn--active {
        background: var(--text-heading);
        color: var(--bg-page);
        border-color: var(--text-heading);
      }
    </style>

    <!-- Contato -->
    <section id="contact" class="mx-auto w-full max-w-[1200px] px-6 py-16">
      <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">

        <div class="flex flex-col gap-6 max-w-[480px]">
          <div class="flex flex-col gap-3">
            <h2 data-animate class="font-display text-section font-semibold text-heading">Vamos conversar</h2>
            <p data-animate style="--animate-delay: 80ms" class="text-lg leading-relaxed" style="color: var(--text-secondary);">
              Estou aberto a posições sênior de product design, projetos de consultoria e conversas sobre UX e IA.
            </p>
          </div>
          <div data-animate style="--animate-delay: 160ms" class="flex flex-col gap-4">
            <div class="flex flex-col gap-1">
              <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--text-subtle);">E-mail</span>
              <a href="mailto:jfreiry@gmail.com" class="text-base font-medium transition-opacity hover:opacity-70" style="color: var(--text-heading);">jfreiry@gmail.com</a>
            </div>
            <div class="flex flex-col gap-1">
              <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--text-subtle);">LinkedIn</span>
              <a href="https://linkedin.com/in/jefersonfreiry" target="_blank" rel="noopener noreferrer" class="text-base font-medium transition-opacity hover:opacity-70" style="color: var(--text-heading);">linkedin.com/in/jefersonfreiry</a>
            </div>
            <div class="flex flex-col gap-1">
              <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--text-subtle);">Localização</span>
              <span class="text-base" style="color: var(--text-secondary);">Porto Alegre, RS · Brasil</span>
            </div>
            <div class="pt-2">
              <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border-[1.5px] px-5 py-3 text-sm font-semibold transition-all hover:-translate-y-px" style="border-color: #25D366; color: #25D366; font-family: var(--font-body);" onmouseover="this.style.background='#25D366';this.style.color='#fff'" onmouseout="this.style.background='';this.style.color='#25D366'">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Falar pelo WhatsApp
              </a>
            </div>
          </div>
        </div>

        <div data-animate style="--animate-delay: 120ms">
          <ContactForm lang="pt" {whatsappHref} client:visible />
        </div>

      </div>
    </section>
  </main>

  <Footer lang="pt" />
</Base>
