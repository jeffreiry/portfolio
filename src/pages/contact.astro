---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.svelte';

const whatsappHref = 'https://wa.me/5551984741888';
---

<Base
  title="Contact — Jeferson Freiry"
  description="Get in touch with Jeferson Freiry — Senior Product Designer. Send a message or chat on WhatsApp."
  lang="en"
>
  <Header lang="en" currentPath="/contact" />

  <main class="mx-auto w-full max-w-[1200px] px-6 py-16">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">

      <!-- Left: copy -->
      <div class="flex flex-col gap-6 max-w-[480px]">
        <div class="flex flex-col gap-3">
          <h1 class="font-display text-4xl font-bold" style="color: var(--color-cha-mate);">
            Let's talk
          </h1>
          <p class="text-lg leading-relaxed" style="color: var(--color-muted);">
            I'm open to senior product design roles, consulting projects, and interesting conversations about UX and AI.
          </p>
        </div>

        <div class="flex flex-col gap-4 pt-2">
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--color-faint, #b0a8a0);">Email</span>
            <a
              href="mailto:jfreiry@gmail.com"
              class="text-base font-medium transition-opacity hover:opacity-70"
              style="color: var(--color-cha-mate);"
            >
              jfreiry@gmail.com
            </a>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--color-faint, #b0a8a0);">LinkedIn</span>
            <a
              href="https://linkedin.com/in/jefersonfreiry"
              target="_blank"
              rel="noopener noreferrer"
              class="text-base font-medium transition-opacity hover:opacity-70"
              style="color: var(--color-cha-mate);"
            >
              linkedin.com/in/jefersonfreiry
            </a>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--color-faint, #b0a8a0);">Location</span>
            <span class="text-base" style="color: var(--color-muted);">Porto Alegre, RS · Brazil</span>
          </div>
        </div>
      </div>

      <!-- Right: form (Svelte island) -->
      <div>
        <ContactForm lang="en" {whatsappHref} client:load />
      </div>

    </div>
  </main>

  <Footer lang="en" />
</Base>
