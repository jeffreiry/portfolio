---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import CaseCard from '../components/CaseCard.astro';
import ContactForm from '../components/ContactForm.svelte';
import RunWidget from '../components/RunWidget.astro';
import WorkoutWidget from '../components/WorkoutWidget.astro';
import { getCollection } from 'astro:content';
import { detectCardImage } from '../utils/cover';

const allCases = await getCollection('casesEn', ({ data }) => !data.draft && !data.protected);
const cases = allCases.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const whatsappHref = 'https://wa.me/5551984741888';
---

<Base
  title="Jeferson Freiry — Product Designer"
  description="Senior Product Designer focused on complex enterprise systems. I design data-driven products and AI-powered platforms that help organizations access knowledge, streamline workflows, and make better decisions."
  lang="en"
>
  <Header lang="en" currentPath="/" />

  <main id="main-content" class="flex flex-col gap-6 pb-24">
    <Hero
      headline="Jeferson Freiry"
      role="Senior Product Designer · UX & AI-Powered Systems"
      body="I design data-driven products and AI-integrated platforms that transform complex enterprise processes into clear, usable experiences — from discovery to delivery."
      contactLabel="Get in touch →"
      contactHref="#contact"
      bgVideo="/Gh011011.mp4"
      bgImage="https://images.unsplash.com/photo-1742647338510-53378767ecd7?w=800&q=80"
    />

    <!-- About + Career lado a lado -->
    <section class="mx-auto w-full max-w-[1200px] px-6 py-10">
      <div class="grid gap-16 lg:grid-cols-2 lg:gap-20">

        <!-- About -->
        <div id="about" class="flex flex-col gap-4">
          <h2 data-animate class="font-display text-section font-semibold text-heading">About</h2>
          <p data-animate style="--animate-delay: 80ms" class="text-lg leading-relaxed text-secondary">
            I am a Senior Product Designer with 5+ years in UX/UI and 10+ years in marketing and digital communication — a background that shapes how I think about brand, narrative, and business context alongside usability.
          </p>
          <p data-animate style="--animate-delay: 160ms" class="text-lg leading-relaxed text-secondary">
            My current focus is enterprise systems and AI-powered platforms: environments where users navigate large volumes of information, complex workflows, and real operational stakes. At Braskem, I lead UX practices and AI-integrated design workflows for industrial-scale platforms — including design critiques, team onboarding, and technical interviews. I collaborate regularly with international stakeholders in English.
          </p>

          <div data-animate style="--animate-delay: 200ms" class="flex flex-wrap gap-3 pt-1">
            <a
              href="/Jeferson_Freiry_EN.pdf"
              download
              class="inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors hover:bg-surface"
              style="border-color: var(--border-default); color: var(--text-heading); font-family: var(--font-body);"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download my Resume
            </a>
          </div>

          <!-- Education -->
          <div class="flex flex-col gap-3 pt-2">
            <h3 data-animate style="--animate-delay: 240ms; font-family: var(--font-body); font-size: var(--text-eyebrow); font-weight: 600; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--text-subtle);">Education</h3>
            <div class="grid gap-3 sm:grid-cols-2 items-stretch">
              <div data-animate style="--animate-delay: 280ms" class="flex flex-col gap-1 rounded-2xl bg-surface p-4 h-full">
                <span class="text-sm font-semibold text-primary">Bachelor's in Advertising and Marketing</span>
                <span class="text-xs text-subtle">Universidade Feevale · 2016</span>
              </div>
              <div data-animate style="--animate-delay: 320ms" class="flex flex-col gap-1 rounded-2xl bg-surface p-4 h-full">
                <span class="text-sm font-semibold text-primary">Specialization in User Experience</span>
                <span class="text-xs text-subtle">Uniritter · 2021</span>
              </div>
            </div>
          </div>

          <h3 data-animate style="--animate-delay: 360ms; font-family: var(--font-body); font-size: var(--text-eyebrow); font-weight: 600; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--text-subtle);">
            Other activities outside work
          </h3>
          <div class="grid gap-3 sm:grid-cols-2">
            <div data-animate style="--animate-delay: 400ms">
              <RunWidget lang="en" />
            </div>
            <div data-animate style="--animate-delay: 470ms">
              <WorkoutWidget lang="en" />
            </div>
          </div>
        </div>

        <!-- Career -->
        <div id="career" class="flex flex-col gap-4">
          <h2 data-animate class="font-display text-section font-semibold text-heading">Career</h2>
          <div class="grid flex-1 gap-3 sm:grid-cols-2" style="grid-auto-rows: 1fr;">
            {[
              { company: 'Braskem',    logo: '/logos/braskem.avif',    role: 'Product Designer', period: '2025 — Present', description: 'Leading UX practices and AI-integrated design workflows for industrial-scale platforms.' },
              { company: 'ilegra',     logo: '/logos/ilegra.png',      role: 'Product Designer', period: '2023 — 2025', description: 'Enterprise product design and UX research across industrial, financial, and consulting engagements.' },
              { company: 'CWI',        logo: '/logos/cwi.png',        role: 'Product Designer', period: '2022 — 2023', description: 'End-to-end UX for large clients in Fashion, Food & Beverage, and Telecommunications.' },
              { company: 'Intelipost', logo: '/logos/Intelipost.png', role: 'UX Researcher',    period: '2021 — 2022', description: 'Mapped the end-to-end user journey from product acquisition to daily use.' },
              { company: 'eSales',     logo: '/logos/esales.png',      role: 'Product Designer', period: '2021', description: 'User research, journey mapping, and product discovery for digital solutions.' },
            ].map((item, i) => (
              <div data-animate style={`--animate-delay: ${i * 70}ms`} class="flex flex-col gap-3 rounded-2xl bg-surface p-5">
                <img
                  src={item.logo}
                  alt={item.company}
                  class={`career-logo${item.opaque ? ' career-logo-opaque' : ''} h-[22px] w-[94px] object-contain object-left`}
                  loading="lazy"
                />
                <span class="text-sm font-semibold text-primary">{item.role}</span>
                <span class="text-sm text-subtle">{item.period}</span>
                <p class="text-sm leading-relaxed text-secondary">{item.description}</p>
              </div>
            ))}
            <!-- LinkedIn card sem preenchimento -->
            <a
              data-animate
              style="--animate-delay: 350ms"
              href="https://linkedin.com/in/jefersonfreiry"
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col justify-center gap-1 rounded-2xl border p-5 transition-colors hover:bg-surface"
              style="border-color: var(--border-default);"
            >
              <span class="text-sm font-semibold text-primary">Full history</span>
              <span class="text-sm" style="color: var(--text-secondary);">linkedin.com/in/jefersonfreiry →</span>
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- Cases grid -->
    <section id="cases" class="mx-auto w-full max-w-[1200px] px-6">
      <h2 data-animate class="font-display text-section font-semibold text-heading mb-4">Cases</h2>

      <!-- Filter bar -->
      <div data-animate style="--animate-delay: 80ms" class="filter-bar flex flex-wrap gap-2 mb-6" role="group" aria-label="Filter cases by category">
        <button class="filter-btn filter-btn--active" data-filter="all" aria-pressed="true">All</button>
        {["Enterprise", "AI & Automation", "UX Research", "Design System", "Branding", "Mobile", "Data & Analytics"].map(tag => (
          <button class="filter-btn" data-filter={tag} aria-pressed="false">{tag}</button>
        ))}
      </div>
      <!-- Live region para anunciar resultado do filtro a leitores de tela -->
      <p id="filter-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>

      <div id="cases-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {cases.map((c, i) => (
          <div data-animate style={`--animate-delay: ${i * 90}ms`} class="case-card-wrapper" data-tags={c.data.tags.join(',')}>
            <CaseCard {...c.data} cover={detectCardImage(c.data.slug) ?? c.data.cover} lang="en" />
          </div>
        ))}
        <a
          id="locked-cases-cta"
          data-animate
          style={`--animate-delay: ${cases.length * 90}ms; border-color: var(--border-default);`}
          href="#contact"
          class="flex h-full flex-col justify-center gap-1 rounded-2xl border p-5 transition-colors hover:bg-surface"
        >
          <span class="text-sm leading-relaxed" style="color: var(--text-secondary);">To access other password-protected cases,</span>
          <span class="text-sm font-semibold text-primary">Get in touch →</span>
        </a>
      </div>
    </section>

    <script>
      const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => {
            b.classList.remove('filter-btn--active');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('filter-btn--active');
          btn.setAttribute('aria-pressed', 'true');
          const filter = btn.dataset.filter!;
          let visible = 0;
          // Live query — cards desbloqueados via link mágico são injetados depois deste script rodar.
          document.querySelectorAll<HTMLElement>('.case-card-wrapper').forEach(card => {
            const tags = card.dataset.tags?.split(',') ?? [];
            const show = filter === 'all' || tags.includes(filter);
            card.style.display = show ? '' : 'none';
            if (show) visible++;
          });
          const status = document.getElementById('filter-status');
          if (status) {
            status.textContent = filter === 'all'
              ? `Showing all ${visible} cases`
              : `${visible} case${visible !== 1 ? 's' : ''} in ${filter}`;
          }
        });
      });

      // Revela cases protegidos na grade quando a sessão está autenticada
      // (via /login ou link mágico ?access=). Sem sessão válida, a API
      // devolve lista vazia — o HTML nunca contém esses cases pra quem não
      // tem acesso.
      async function revealUnlockedCases() {
        try {
          const res = await fetch('/api/unlocked-cases?lang=en');
          const data = await res.json();
          if (!data.unlocked || !data.cases?.length) return;

          const grid = document.getElementById('cases-grid');
          const cta = document.getElementById('locked-cases-cta');
          if (!grid) return;
          cta?.remove();

          [...data.cases].reverse().forEach((c: any) => {
            const wrapper = document.createElement('div');
            wrapper.className = 'case-card-wrapper';
            wrapper.dataset.tags = (c.tags ?? []).join(',');
            const img = c.cover ?? 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?fm=jpg&w=800&q=80&auto=format&fit=crop';
            wrapper.innerHTML = `
              <a href="/work/${c.slug}" class="group flex flex-col overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-4" style="border-radius: var(--radius-card); --tw-ring-color: var(--text-heading); background-color: var(--bg-surface); border: 0.5px solid var(--border-default); transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), box-shadow 0.35s cubic-bezier(0.16,1,0.3,1);">
                <div class="relative w-full overflow-hidden" style="height: 200px;">
                  <img src="${img}" alt="${c.title}" class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]" loading="lazy" />
                  <div class="absolute bottom-0 left-0 right-0 pointer-events-none" style="height: 3px; background-color: var(--accent-deco);"></div>
                </div>
                <div class="flex flex-col gap-3 p-5">
                  <div class="flex items-center gap-2">
                    <span class="text-caption uppercase tracking-[var(--tracking-caption)]" style="color: var(--text-subtle); font-weight: 600; font-family: var(--font-body);">${c.year}</span>
                  </div>
                  <h3 class="font-display" style="font-size: var(--text-card); line-height: var(--leading-heading); color: var(--text-heading);">${c.title}</h3>
                  <p class="line-clamp-2 leading-relaxed" style="font-size: var(--text-xs); font-weight: 400; font-family: var(--font-body); color: var(--text-secondary); min-height: calc(var(--text-xs) * var(--leading-normal) * 2);">${c.summary}</p>
                  <div class="flex flex-wrap justify-center gap-1.5">
                    ${(c.tags ?? []).slice(0, 3).map((t: string) => `<span class="rounded-full px-2.5 py-1 text-caption font-medium" style="background: var(--bg-surface-alt); color: var(--text-primary); font-family: var(--font-body);">${t}</span>`).join('')}
                  </div>
                  <div class="flex justify-center mt-3 lg:hidden">
                    <span class="inline-flex items-center justify-center" style="background: transparent; border: 1.5px solid var(--accent-text); border-radius: var(--radius-pill); padding: 9px 28px; font-size: 12px; font-weight: 600; font-family: var(--font-body); color: var(--accent-text); letter-spacing: 0.02em;">View case →</span>
                  </div>
                </div>
              </a>
            `;
            grid.prepend(wrapper);
          });
        } catch {
          // rede indisponível — cases desbloqueados simplesmente não aparecem, sem quebrar a grade
        }
      }
      // Espera o link mágico (Base.astro) confirmar se setou o cookie antes de
      // checar a sessão — os dois fetches são independentes, sem essa espera
      // a checagem pode rodar antes do cookie existir.
      if ((window as any).__magicLinkChecked) {
        revealUnlockedCases();
      } else {
        window.addEventListener('magic-link:checked', revealUnlockedCases, { once: true });
      }
    </script>

    <style>
      .filter-btn {
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.04em;
        padding: 6px 14px;
        border-radius: 999px;
        border: 1px solid var(--border-default);
        color: var(--text-secondary);
        background: transparent;
        cursor: pointer;
        transition: color 0.15s, background 0.15s, border-color 0.15s;
      }
      .filter-btn:hover {
        color: var(--text-heading);
        border-color: var(--text-heading);
      }
      .filter-btn--active {
        background: var(--text-heading);
        color: var(--bg-page);
        border-color: var(--text-heading);
      }
    </style>

    <!-- Contact -->
    <section id="contact" class="mx-auto w-full max-w-[1200px] px-6 py-16">
      <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">

        <div class="flex flex-col gap-6 max-w-[480px]">
          <div class="flex flex-col gap-3">
            <h2 data-animate class="font-display text-section font-semibold text-heading">Let's talk</h2>
            <p data-animate style="--animate-delay: 80ms" class="text-lg leading-relaxed" style="color: var(--text-secondary);">
              I'm open to senior product design roles, consulting projects, and interesting conversations about UX and AI.
            </p>
          </div>
          <div data-animate style="--animate-delay: 160ms" class="flex flex-col gap-4">
            <div class="flex flex-col gap-1">
              <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--text-subtle);">Email</span>
              <a href="mailto:jfreiry@gmail.com" class="text-base font-medium transition-opacity hover:opacity-70" style="color: var(--text-heading);">jfreiry@gmail.com</a>
            </div>
            <div class="flex flex-col gap-1">
              <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--text-subtle);">LinkedIn</span>
              <a href="https://linkedin.com/in/jefersonfreiry" target="_blank" rel="noopener noreferrer" class="text-base font-medium transition-opacity hover:opacity-70" style="color: var(--text-heading);">linkedin.com/in/jefersonfreiry</a>
            </div>
            <div class="flex flex-col gap-1">
              <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--text-subtle);">Location</span>
              <span class="text-base" style="color: var(--text-secondary);">Porto Alegre, RS · Brazil</span>
            </div>
            <div class="pt-2">
              <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border-[1.5px] px-5 py-3 text-sm font-semibold transition-all hover:-translate-y-px" style="border-color: #25D366; color: #25D366; font-family: var(--font-body);" onmouseover="this.style.background='#25D366';this.style.color='#fff'" onmouseout="this.style.background='';this.style.color='#25D366'">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Chat on WhatsApp
              </a>
            </div>
          </div>
        </div>

        <div data-animate style="--animate-delay: 120ms">
          <ContactForm lang="en" {whatsappHref} client:visible />
        </div>

      </div>
    </section>
  </main>

  <Footer lang="en" />
</Base>
