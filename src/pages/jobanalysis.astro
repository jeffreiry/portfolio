---
export const prerender = false;

import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { readdirSync, readFileSync, statSync } from 'fs';
import { join } from 'path';

// Nova Vaga / Editar / Candidatura escrevem no filesystem (Bench_job_applications/*.md)
// — só funciona rodando local (`npm run dev`). Na Vercel o filesystem é read-only,
// então essas ações ficam ocultas em produção; a página vira só-visualização.
const canEdit = import.meta.env.DEV;

// --- Tipos ---

interface SkillTag {
  text: string;
  categoria: 'hard' | 'soft';
  tenho: boolean; // nota >=2 no requisito de origem
}

interface VagaParsed {
  slug: string;
  empresa: string;
  produto: string;
  cargo: string;
  score: number;
  interpretacao: string;
  interpretacaoTexto: string;
  status: string;
  candidatura: string;
  motivoRecusa: string;
  scoreAnterior: number | null;
  motivoMudancaScore: string;
  prazoCandidatura: string;
  diasParado: number;
  diasAteResposta: number | null;
  data: string;
  tags: SkillTag[];
  tagsFull: SkillTag[];
  bloqueadores: string[];
  ausentes: string[];
  boaAderencia: string[];
  obtObrig: number;
  maxObrigW: number;
  obtPref: number;
  maxPrefW: number;
}

type Banda = 'alta' | 'parcial' | 'baixa' | 'muito-baixa';

// --- Parsing ---

function cleanTag(text: string): string {
  return text
    .replace(/\*\*/g, '')
    .replace(/\s*\([^)]*\)/g, '')
    .replace(/[:—–→,].*/g, '')
    .trim();
}

// Classificação hard/soft por palavra-chave no texto do requisito — automática,
// roda pra todas as vagas do bench (recusadas inclusive) sem editar arquivo por
// arquivo. Sem match nas duas listas, cai em "hard" por padrão (a maioria dos
// requisitos das JDs do bench é técnica/de processo, não comportamental).
const SOFT_SKILL_KEYWORDS = [
  'comunica', 'colabora', 'lideran', 'mentoria', 'stakeholder', 'multidisciplinar',
  'ambigu', 'ágil', 'agil', 'feedback', 'argumenta', 'investigativ', 'curios',
  'resiliên', 'resilien', 'adapta', 'proativ', 'empatia', 'equipe', 'negocia',
  'prioriza', 'apresenta', 'perfil', 'dinâmic', 'dinamic', 'flexibilidade',
  'inglês', 'ingles', 'espanhol', 'idioma', 'fluên', 'fluen', 'generalista',
  'autogestão', 'autogestao', 'autonomia', 'organiza',
];
function classifySkill(text: string): 'hard' | 'soft' {
  const lower = text.toLowerCase();
  return SOFT_SKILL_KEYWORDS.some((kw) => lower.includes(kw)) ? 'soft' : 'hard';
}

// --- Taxonomia canônica (estilo "Competências" do LinkedIn) ---
//
// O texto cru de cada requisito de JD é único demais pra virar contagem útil
// (446 frases distintas em 57 vagas, quase todas com 1 ocorrência) — a mesma
// habilidade aparece como "Domínio de Figma", "Proficiência em Figma" e
// "Figma avançado" em três vagas diferentes. Esta tabela reduz isso a um
// vocabulário fixo de ~40 competências, cada requisito podendo bater em mais
// de uma (uma frase como "Boa comunicação e colaboração em ambientes ágeis"
// é real demanda por três competências distintas ao mesmo tempo).
// Frases de elegibilidade pura (anos de experiência, formação acadêmica) não
// são competência no sentido do LinkedIn — ficam de fora da contagem.
const ELIGIBILITY_PATTERN = /\b(anos? de experi[êe]ncia|gradua[çc][ãa]o|forma[çc][ãa]o (em|acad[êe]mica)|ensino superior|bachelor|degree in)\b/i;

const SKILL_TAXONOMY: { canon: string; categoria: 'hard' | 'soft'; pattern: RegExp }[] = [
  // Hard — ferramentas e técnicas
  { canon: 'Figma',                              categoria: 'hard', pattern: /figma/i },
  { canon: 'Prototipação',                       categoria: 'hard', pattern: /prototip|protót|prototype/i },
  { canon: 'Wireframes',                         categoria: 'hard', pattern: /wireframe/i },
  { canon: 'UX/UI Design',                       categoria: 'hard', pattern: /\bux\b.{0,3}\bui\b|\bui\b.{0,3}\bux\b|design de intera[çc][ãa]o|interaction design|design visual|visual design|ui design|ui kit|ui art|ui craft|design refined/i },
  { canon: 'Arquitetura da Informação',          categoria: 'hard', pattern: /arquitetura d[ae] informa[çc][ãa]o|information architecture/i },
  { canon: 'Design Systems',                     categoria: 'hard', pattern: /design system/i },
  { canon: 'Pesquisa com Usuários (UX Research)', categoria: 'hard', pattern: /pesquisa|\bresearch\b|entrevista/i },
  { canon: 'Discovery / Design Thinking',        categoria: 'hard', pattern: /discovery|design thinking|valida[çc][ãa]o de hip[óo]tese/i },
  { canon: 'Testes de Usabilidade',              categoria: 'hard', pattern: /usabilidade|usability/i },
  { canon: 'Acessibilidade (WCAG)',              categoria: 'hard', pattern: /acessibilidade|wcag|accessibility/i },
  { canon: 'Métricas de Produto / Dados',        categoria: 'hard', pattern: /m[ée]trica|\bkpi\b|data-inform|data-heavy|indicador|analytics|a\/b test/i },
  { canon: 'Handoff / Documentação Técnica',     categoria: 'hard', pattern: /handoff|handover|especifica[çc][ãa]o t[ée]cnica|documenta[çc][ãa]o/i },
  { canon: 'Design Responsivo / Mobile',         categoria: 'hard', pattern: /\bmobile\b|responsiv|\bios\b|\bandroid\b|app nativo|para celular/i },
  { canon: 'Design de Serviço / Jornadas',       categoria: 'hard', pattern: /jornada|service design|design de servi[çc]o|blueprint/i },
  { canon: 'Metodologias Ágeis',                 categoria: 'hard', pattern: /\b[aá]gil|agile|scrum|sprint/i },
  { canon: 'IA aplicada a Design',               categoria: 'hard', pattern: /\bia\b|\bai\b|intelig[êe]ncia artificial|\bllm\b|prompt/i },
  { canon: 'Front-end (HTML/CSS)',               categoria: 'hard', pattern: /\bhtml\b|\bcss\b|front-?end/i },
  { canon: 'Inglês',                             categoria: 'hard', pattern: /ingl[êe]s|english/i },
  { canon: 'Espanhol',                           categoria: 'hard', pattern: /espanhol|spanish/i },
  { canon: 'Portfólio / Processo de Design',     categoria: 'hard', pattern: /portf[óo]lio|portfolio|\bcraft\b/i },
  { canon: 'Motion Design',                      categoria: 'hard', pattern: /motion/i },
  { canon: 'Facilitação de Workshops',           categoria: 'hard', pattern: /workshop|facilita/i },
  { canon: 'Gestão / Visão de Produto',          categoria: 'hard', pattern: /vis[ãa]o de produto|product thinking|gerenciamento de produto|product management|ciclo de vida do produto/i },
  { canon: 'Growth / Conversão',                 categoria: 'hard', pattern: /growth|convers[ãa]o|reten[çc][ãa]o|funil/i },
  { canon: 'Domínio Fintech / Pagamentos',       categoria: 'hard', pattern: /fintech|pagamento|cr[ée]dito|financeir/i },

  // Soft — comportamento e colaboração
  { canon: 'Comunicação',                        categoria: 'soft', pattern: /comunica[çc][ãa]o|communication/i },
  { canon: 'Colaboração Multifuncional',         categoria: 'soft', pattern: /colabora|multidisciplinar|cross-?funcional|cross[- ]functional/i },
  { canon: 'Gestão de Stakeholders',             categoria: 'soft', pattern: /stakeholder/i },
  { canon: 'Autonomia / Ownership',              categoria: 'soft', pattern: /autonomia|ownership|senso de dono|proativ/i },
  { canon: 'Adaptabilidade / Ambiguidade',       categoria: 'soft', pattern: /ambigu|adapta[çc][ãa]o|flexibilidade|mudan[çc]as? (frequentes|de)/i },
  { canon: 'Pensamento Crítico / Analítico',     categoria: 'soft', pattern: /cr[íi]tico|anal[íi]tic|racioc[íi]nio l[óo]gico/i },
  { canon: 'Liderança / Mentoria',               categoria: 'soft', pattern: /lideran[çc]a|mentoria|mentor|leadership/i },
  { canon: 'Visão Estratégica',                  categoria: 'soft', pattern: /estrat[ée]g|strategic/i },
  { canon: 'Organização / Priorização',          categoria: 'soft', pattern: /organiza[çc][ãa]o|prioriza[çc][ãa]o|gest[ãa]o de tempo/i },
  { canon: 'Empatia / Centrado no Usuário',      categoria: 'soft', pattern: /empatia|centrad[ao] no usu[áa]rio|human-centered/i },
  { canon: 'Argumentação / Apresentação',        categoria: 'soft', pattern: /argumenta|apresenta[çc][ãa]o|storytelling/i },
  { canon: 'Curiosidade / Perfil Investigativo', categoria: 'soft', pattern: /curiosidade|investigativ|curios/i },
  { canon: 'Negociação / Mediação de Conflitos', categoria: 'soft', pattern: /negocia|media[çc][ãa]o|conflito/i },
  { canon: 'Trabalho Remoto / Autogestão',       categoria: 'soft', pattern: /trabalho remoto|remoto|autogest[ãa]o|self-motivated|disciplina/i },
];

/** Retorna os nomes canônicos que o texto do requisito bate — pode ser mais de um, ou nenhum. */
function canonicalizeSkill(text: string): { canon: string; categoria: 'hard' | 'soft' }[] {
  if (ELIGIBILITY_PATTERN.test(text)) return [];
  return SKILL_TAXONOMY.filter((s) => s.pattern.test(text)).map((s) => ({ canon: s.canon, categoria: s.categoria }));
}

function scoreLabel(score: number): string {
  if (score >= 80) return 'Alta aderência';
  if (score >= 60) return 'Aderência parcial';
  if (score >= 40) return 'Aderência baixa';
  return 'Desalinhamento estrutural';
}

function parseVagaFile(filename: string, dir: string): VagaParsed | null {
  try {
    const content = readFileSync(join(dir, filename), 'utf-8');
    const slug = filename.replace('.md', '');

    const scoreMatch = content.match(/## Score de ader[eê]ncia[^·\n]*·\s*(\d+)%/);
    const score = scoreMatch ? parseInt(scoreMatch[1]) : 0;

    const empresaMatch = content.match(/\*\*Empresa:\*\*\s*(.+)/);
    const empresa = empresaMatch?.[1]?.trim() ?? slug;

    const produtoMatch = content.match(/\*\*Produto:\*\*\s*(.+)/);
    const produtoRaw = produtoMatch?.[1]?.trim() ?? '';
    const produto = produtoRaw.replace(/\s*\([^)]*\).*/, '').trim();

    const nivelMatch = content.match(/\*\*N[íi]vel:\*\*\s*(.+)/);
    const nivelRaw = nivelMatch?.[1]?.trim() ?? '';
    const cargo = nivelRaw.replace(/\s*·\s*T\d+.*/, '').replace(/\s*—.*/, '').trim();

    const dataMatch = content.match(/\*\*Data da vaga:\*\*\s*(.+)/);
    const data = dataMatch?.[1]?.trim() ?? '';

    const statusMatch = content.match(/\*\*Status:\*\*\s*(.+)/);
    const status = statusMatch?.[1]?.trim() ?? 'A avaliar';

    const candidaturaMatch = content.match(/\*\*Candidatura:\*\*\s*(.+)/);
    const candidatura =
      candidaturaMatch?.[1]?.trim() ??
      (status.toLowerCase().includes('pendente') ? 'Sim' : 'Não');

    const motivoMatch = content.match(/\*\*Motivo da recusa:\*\*\s*(.+)/);
    const motivoRecusa = motivoMatch?.[1]?.trim() ?? '';

    // Campo opcional "**Score anterior:**" — preenchido só quando uma reanálise
    // muda o score de uma vaga já validada (convenção 2026-09-13). Extrai só o
    // número; o resto da linha (data, motivo) fica só na leitura humana do arquivo.
    const scoreAnteriorMatch = content.match(/\*\*Score anterior:\*\*\s*(\d+)%/);
    const scoreAnterior = scoreAnteriorMatch ? parseInt(scoreAnteriorMatch[1]) : null;

    const motivoMudancaMatch = content.match(/\*\*Motivo da mudança de score:\*\*\s*(.+)/);
    const motivoMudancaScore = motivoMudancaMatch?.[1]?.trim() ?? '';

    // "Status atualizado em" é carimbado pelo servidor (jobanalysis-analyze.ts na
    // criação, jobanalysis-update.ts a cada edição) — nunca escrito pelo autor à
    // mão nem pelo Claude. Vagas de antes desta convenção (2026-09-13) não têm o
    // campo até serem tocadas de novo; "dias parado" fica ausente pra elas em vez
    // de inventar uma data a partir de mtime de arquivo, que já provou ser pouco
    // confiável (uma edição em lote no conteúdo não é a mesma coisa que mudar status).
    const statusAtualizadoMatch = content.match(/\*\*Status atualizado em:\*\*\s*(\d{4}-\d{2}-\d{2})/);
    const diasParado = statusAtualizadoMatch
      ? Math.floor((Date.now() - new Date(statusAtualizadoMatch[1] + 'T12:00:00').getTime()) / 86400000)
      : -1; // -1 = desconhecido, não "0 dias"

    const prazoMatch = content.match(/\*\*Prazo de candidatura:\*\*\s*(\d{4}-\d{2}-\d{2})/);
    const prazoCandidatura = prazoMatch?.[1] ?? '';

    // "Dias até resposta" só existe quando a vaga já SAIU de "Candidatura enviada"
    // pra algum estágio seguinte (Entrevista, Em processo, Proposta, Recusado) —
    // enquanto ainda está em "Candidatura enviada", não houve resposta ainda,
    // então o cálculo não faz sentido (seria "dias parado", não "dias até resposta").
    const candidaturaEnviadaMatch = content.match(/\*\*Candidatura enviada em:\*\*\s*(\d{4}-\d{2}-\d{2})/);
    const estagiosPosResposta = ['Entrevista agendada', 'Em processo', 'Proposta recebida', 'Recusado'];
    const diasAteResposta = (candidaturaEnviadaMatch && statusAtualizadoMatch && estagiosPosResposta.includes(status))
      ? Math.max(0, Math.floor((new Date(statusAtualizadoMatch[1] + 'T12:00:00').getTime() - new Date(candidaturaEnviadaMatch[1] + 'T12:00:00').getTime()) / 86400000))
      : null;

    const blockquoteMatch = content.match(/## Score de ader[eê]ncia[^\n]*\n\n>\s*(.+)/);
    const interpretacaoTexto = blockquoteMatch?.[1]?.trim() ?? '';

    // Tags dos requisitos obrigatórios — texto + nota (>=2 vira "tenho" preenchido,
    // <=1 vira contorno de gap) + categoria hard/soft por palavra-chave.
    // Escopo cortado no próximo heading (##/###) — sem isso, a extração engolia
    // TODAS as tabelas seguintes do arquivo (Diferenciais, Cálculo), já que
    // antes só não aparecia porque o .slice(0,6) do card escondia a poluição.
    const tags: SkillTag[] = [];
    const afterReqHeader = content.split(/### Requisitos obrigat[oó]rios/)[1]?.split(/\n#{2,3} /)[0];
    if (afterReqHeader) {
      const tableLines = afterReqHeader.split('\n').filter((l) => l.startsWith('|'));
      for (const line of tableLines) {
        if (line.includes('Requisito') || line.includes('---')) continue;
        const cells = line.split('|').filter((c) => c.trim());
        if (cells[0]) {
          const tag = cleanTag(cells[0]);
          const nota = Number(cells[1]?.trim());
          if (tag && tag.length > 2 && !tag.includes('⬜')) {
            tags.push({ text: tag, categoria: classifySkill(tag), tenho: Number.isFinite(nota) && nota >= 2 });
          }
        }
      }
    }

    // Gaps
    const gapsSection = content.split(/## Gaps prioritários/i)[1] ?? '';
    function gapItems(pat: RegExp, strip: RegExp): string[] {
      const m = gapsSection.match(pat);
      const raw = m?.[1]?.trim() ?? '';
      if (!raw || raw.toLowerCase().startsWith('nenhum')) return [];
      return raw.split('\n').map((l) => l.replace(strip, '').trim()).filter(Boolean);
    }
    const bloqueadores = gapItems(/### 🔴 Bloqueadores[^\n]*\n\n([\s\S]*?)(?=\n###|$)/, /^\*\s*/);
    const ausentes     = gapItems(/### 🟡 Diferenciais ausentes[^\n]*\n\n([\s\S]*?)(?=\n###|$)/, /^\d+\.\s*/);
    const boaAderencia = gapItems(/### 🟢 Boa ader[eê]ncia[^\n]*\n\n([\s\S]*?)(?=\n###|$)/, /^\*\s*/);

    // Score breakdown da tabela de cálculo
    const calcSection = content.split(/### C[aá]lculo/i)[1] ?? '';
    const obrigRow = calcSection.match(/Obrigat[oó]rios[^|]*\|\s*(\d+)\s*\|\s*(\d+)/);
    const prefRow  = calcSection.match(/Preferidos[^|]*\|\s*(\d+)\s*\|\s*(\d+)/);
    const obtObrig  = obrigRow ? parseInt(obrigRow[1]) : 0;
    const maxObrigW = obrigRow ? parseInt(obrigRow[2]) : 0;
    const obtPref   = prefRow  ? parseInt(prefRow[1])  : 0;
    const maxPrefW  = prefRow  ? parseInt(prefRow[2])  : 0;

    return {
      slug,
      empresa,
      produto,
      cargo,
      score,
      interpretacao: scoreLabel(score),
      interpretacaoTexto,
      status,
      candidatura,
      motivoRecusa,
      scoreAnterior,
      motivoMudancaScore,
      prazoCandidatura,
      diasParado,
      diasAteResposta,
      data,
      tags: tags.slice(0, 6),
      tagsFull: tags,
      bloqueadores,
      ausentes,
      boaAderencia,
      obtObrig,
      maxObrigW,
      obtPref,
      maxPrefW,
    };
  } catch {
    return null;
  }
}

interface GapTransversal {
  gap: string;
  impacto: string;
  vagas: string;
  acao: string;
}

interface FofaQuadrante {
  emoji: string;
  titulo: string;
  headers: string[];
  rows: string[][];
}

// Parser de tabela markdown genérico: lê header + linhas de dados de um bloco
// de texto, ignorando a linha separadora "|---|---|". Reaproveitado pelos 4
// quadrantes da FOFA, que têm números de coluna diferentes entre si.
function parseMarkdownTable(block: string): { headers: string[]; rows: string[][] } {
  const lines = block.split('\n').map((l) => l.trim()).filter((l) => l.startsWith('|'));
  if (lines.length < 2) return { headers: [], rows: [] };
  const parseCells = (line: string) => {
    const cells = line.split('|');
    return cells.slice(1, cells.length - 1).map((c) => c.trim());
  };
  const headers = parseCells(lines[0]);
  const rows = lines.slice(1).filter((l) => !/^\|?\s*-+\s*\|/.test(l)).map(parseCells);
  return { headers, rows };
}

// Lê a tabela "## Gaps transversais" direto do _index.md — antes era um array
// hardcoded aqui na página, que ficava desatualizado sempre que o _index.md
// mudava e ninguém lembrava de replicar manualmente (achado real em 2026-09-12:
// a versão hardcoded chegou a divergir tanto no número de vagas afetadas quanto
// em faltar uma linha inteira). Agora as duas fontes não podem mais divergir
// porque só existe uma.
function parseGapsTransversais(dir: string): GapTransversal[] {
  try {
    const content = readFileSync(join(dir, '_index.md'), 'utf-8');
    // Limitado ao próximo "## " (ou fim do arquivo) — sem isso, uma seção nova
    // adicionada depois desta (ex: Matriz FOFA) teria suas tabelas engolidas
    // aqui também, já que elas também começam com "|" (achado real em 2026-09-13,
    // ao adicionar a seção FOFA logo em seguida).
    const section = content.split(/## Gaps transversais/i)[1]?.split(/\n## /)[0] ?? '';
    const tableLines = section.split('\n').filter((l) => l.trim().startsWith('|'));

    const result: GapTransversal[] = [];
    for (const line of tableLines) {
      if (line.includes('---') || /\|\s*Gap\s*\|/i.test(line)) continue;
      const cells = line.split('|').map((c) => c.trim());
      const [, gapRaw, impacto, vagas, acao] = cells;
      if (!gapRaw || !impacto) continue;
      const gap = gapRaw.replace(/\*\*/g, '').replace(/`/g, '');
      result.push({ gap, impacto, vagas: vagas ?? '', acao: acao ?? '' });
    }
    return result;
  } catch {
    return [];
  }
}

// Lê a "## Matriz FOFA" do _index.md — mesmo princípio de fonte única dos Gaps
// transversais. Diferente daquela, esta seção NÃO é recalculada a cada vaga
// nova: só muda quando o autor pede explicitamente ("atualizar a FOFA"),
// convenção registrada no CLAUDE.md.
function parseFOFA(dir: string): FofaQuadrante[] {
  try {
    const content = readFileSync(join(dir, '_index.md'), 'utf-8');
    const afterHeading = content.split(/## Matriz FOFA/i)[1];
    if (!afterHeading) return [];
    const section = afterHeading.split(/\n## /)[0]; // limitado ao próximo "## " (ou fim do arquivo)

    const quadrantes: { marker: string; titulo: string }[] = [
      { marker: '🟩', titulo: 'Forças' },
      { marker: '🟥', titulo: 'Fraquezas' },
      { marker: '🟦', titulo: 'Oportunidades' },
      { marker: '⬛', titulo: 'Ameaças' },
    ];

    const result: FofaQuadrante[] = [];
    const blocks = section.split(/\n### /).slice(1);
    for (const block of blocks) {
      const titleLine = block.split('\n')[0];
      const def = quadrantes.find((q) => titleLine.includes(q.marker));
      if (!def) continue;
      const body = block.split('\n').slice(1).join('\n');
      const { headers, rows } = parseMarkdownTable(body);
      if (!headers.length) continue;
      result.push({ emoji: def.marker, titulo: def.titulo, headers, rows });
    }
    return result;
  } catch {
    return [];
  }
}

const benchDir = join(process.cwd(), 'Bench_job_applications');

let vagas: VagaParsed[] = [];
try {
  const files = readdirSync(benchDir).filter((f) => f.endsWith('.md') && !f.startsWith('_'));
  vagas = files
    .map((f) => parseVagaFile(f, benchDir))
    .filter((v): v is VagaParsed => v !== null)
    .sort((a, b) => b.score - a.score);
} catch {
  // fallback vazio — não quebra o build
}

const media = vagas.length ? Math.round(vagas.reduce((s, v) => s + v.score, 0) / vagas.length) : 0;
const parciais = vagas.filter((v) => v.score >= 60).length;
const maxScore = vagas.length ? Math.max(...vagas.map((v) => v.score)) : 0;

const lastVagaDate = vagas
  .map((v) => v.data)
  .filter((d) => /^\d{4}-\d{2}-\d{2}$/.test(d))
  .sort()
  .at(-1) ?? '';

const candidaturaCounts: Record<'Sim' | 'Não', number> = {
  Sim: vagas.filter((v) => v.candidatura === 'Sim').length,
  Não: vagas.filter((v) => v.candidatura === 'Não').length,
};

// Skills agregadas do bench inteiro (todas as vagas, recusadas inclusive — é
// leitura de demanda de mercado, não score de vaga individual). Dedup por texto
// normalizado; "tenho" vale se QUALQUER análise já deu nota >=2 pro requisito,
// mesmo que outra vaga com JD mais exigente tenha dado nota mais baixa pro
// mesmo texto — é o retrato mais generoso e ainda assim honesto do que já foi
// comprovado em pelo menos um contexto real.
interface SkillAgg { text: string; categoria: 'hard' | 'soft'; count: number; tenho: boolean }
const skillMap = new Map<string, SkillAgg>();
for (const v of vagas) {
  for (const tag of v.tagsFull) {
    for (const { canon, categoria } of canonicalizeSkill(tag.text)) {
      const existing = skillMap.get(canon);
      if (existing) {
        existing.count += 1;
        existing.tenho = existing.tenho || tag.tenho;
      } else {
        skillMap.set(canon, { text: canon, categoria, count: 1, tenho: tag.tenho });
      }
    }
  }
}
const skillsAgg = Array.from(skillMap.values()).sort((a, b) => b.count - a.count || a.text.localeCompare(b.text));
const skillsTenhoCount = skillsAgg.filter((s) => s.tenho).length;
const skillsGapCount = skillsAgg.length - skillsTenhoCount;

function mediaLabel(s: number): string {
  if (s >= 80) return 'alta aderência';
  if (s >= 60) return 'aderência parcial';
  if (s >= 40) return 'aderência baixa';
  return 'desalinhamento estrutural';
}

function banda(score: number): Banda {
  if (score >= 80) return 'alta';
  if (score >= 60) return 'parcial';
  if (score >= 40) return 'baixa';
  return 'muito-baixa';
}

const bandaCor: Record<Banda, { fill: string; chipBg: string; chipText: string }> = {
  alta:          { fill: '#2f6e3f', chipBg: 'var(--color-tag-research-bg)',   chipText: 'var(--color-tag-research-text)'   },
  parcial:       { fill: '#4d6046', chipBg: 'var(--color-tag-dataviz-bg)',    chipText: 'var(--color-tag-dataviz-text)'    },
  baixa:         { fill: '#ed6707', chipBg: 'var(--color-tag-enterprise-bg)', chipText: 'var(--color-tag-enterprise-text)' },
  'muito-baixa': { fill: '#8c2f0d', chipBg: 'var(--color-tag-enterprise-bg)', chipText: 'var(--color-tag-enterprise-text)' },
};

const rubrica = [
  { nota: '0', criterio: 'Ausente — sem evidência no portfolio' },
  { nota: '1', criterio: 'Parcialmente evidenciado — mencionado, sem profundidade ou artefatos visíveis' },
  { nota: '2', criterio: 'Claramente evidenciado — case completo com processo documentado' },
  { nota: '3', criterio: 'Diferencial — evidência forte com contexto, resultados ou detalhe incomum' },
];

const gaps = parseGapsTransversais(benchDir);
const fofa = parseFOFA(benchDir);
const fofaCor: Record<string, { border: string; bg: string }> = {
  '🟩': { border: '#86c99a', bg: '#eefaf1' },
  '🟥': { border: '#e8a3a3', bg: '#fdf1f1' },
  '🟦': { border: '#a3c4e8', bg: '#f0f6fd' },
  '⬛': { border: '#94a3b8', bg: '#f1f3f6' },
};

function formatDate(dateStr: string): string {
  if (!dateStr) return '';
  const parts = dateStr.split('-');
  if (parts.length !== 3) return dateStr;
  return `${parts[2]}/${parts[1]}/${parts[0]}`;
}

const statusOptions = [
  'A avaliar',
  'Candidatura enviada',
  'Entrevista agendada',
  'Em processo',
  'Proposta recebida',
  'Recusado',
  'Arquivado',
];

// Funil — só os estágios "em jogo". Recusado/Arquivado são estados terminais,
// contados à parte (ver funilTerminal) em vez de ocuparem espaço no funil ativo.
const funilAtivo = ['A avaliar', 'Candidatura enviada', 'Entrevista agendada', 'Em processo', 'Proposta recebida'];
const funilCounts = funilAtivo.map((s) => ({ status: s, count: vagas.filter((v) => v.status === s).length }));
const funilTerminal = {
  recusado: vagas.filter((v) => v.status === 'Recusado').length,
  arquivado: vagas.filter((v) => v.status === 'Arquivado').length,
};

// Fila de prioridade — vagas ainda "em jogo" (fora Recusado/Arquivado), ordenadas
// por score desc e, como desempate, por tempo parado desc (diasParado === -1
// quando desconhecido, o que naturalmente empurra pro fim do desempate — não
// inventa urgência pra vaga sem essa data registrada). Top 5, não a lista toda.
const filaPrioridade = vagas
  .filter((v) => funilAtivo.includes(v.status))
  .sort((a, b) => b.score - a.score || b.diasParado - a.diasParado)
  .slice(0, 5);

const statusCounts: Record<string, number> = {};
for (const opt of statusOptions) {
  statusCounts[opt] = vagas.filter((v) => v.status === opt).length;
}
---

<Base
  title="Análise de Candidaturas — Jeferson Freiry"
  description="Bench de aderência das vagas-alvo. Scoring ponderado por Person-Job Fit para calibrar e priorizar o desenvolvimento do portfolio."
  lang="pt"
  noindex={true}
>
  <Header lang="pt" currentPath="/jobanalysis" />

  <main id="main-content" class="pb-24">

    <!-- Hero -->
    <section class="mx-auto w-full max-w-[1200px] px-6 pt-12 md:pt-16">
      <div data-animate class="flex flex-col gap-4 max-w-[760px]">
        <span class="inline-flex w-fit items-center gap-2 rounded-full border px-3 py-1 text-[11px] font-medium uppercase tracking-[0.12em]"
          style="border-color: var(--color-border); color: var(--color-faint); font-family: var(--font-body);">
          Bench · Análise interna
        </span>
        <h1 class="font-display text-[clamp(34px,5vw,56px)] font-semibold leading-[1.1] text-neutral-900">
          Análise de Candidaturas
        </h1>
        <p class="text-lg leading-relaxed text-neutral-600">
          Bench das vagas-alvo para <strong style="color: var(--color-neutral-800);">calibrar e priorizar</strong> o
          desenvolvimento do portfolio. Cada vaga recebe um score de aderência ponderado por
          <em>Person-Job Fit</em> — o quanto as evidências do portfolio atendem ao que o requisito exige.
        </p>
      </div>
    </section>

    <!-- Resumo (stats) -->
    <section class="mx-auto w-full max-w-[1200px] px-6 pt-10">
      <div data-animate class="grid gap-4 grid-cols-2 lg:grid-cols-4">
        <div class="stat-card flex flex-col gap-1 rounded-2xl p-5">
          <span id="stat-total" class="font-display text-3xl font-bold text-neutral-900">{vagas.length}</span>
          <span class="text-sm" style="color: var(--color-faint);">Vagas analisadas</span>
        </div>
        <div class="stat-card flex flex-col gap-1 rounded-2xl p-5">
          <span id="stat-media" class="font-display text-3xl font-bold text-neutral-900">{media}%</span>
          <span class="text-sm" style="color: var(--color-faint);">Média geral</span>
        </div>
        <div class="stat-card flex flex-col gap-1 rounded-2xl p-5">
          <span id="stat-max" class="font-display text-3xl font-bold text-neutral-900">{maxScore}%</span>
          <span class="text-sm" style="color: var(--color-faint);">Maior aderência</span>
        </div>
        <div class="stat-card flex flex-col gap-1 rounded-2xl p-5">
          <span id="stat-parciais" class="font-display text-3xl font-bold text-neutral-900">{parciais}</span>
          <span class="text-sm" style="color: var(--color-faint);">Em aderência parcial (≥60%)</span>
        </div>
      </div>
      <p data-animate class="pt-3 text-[13px]" style="color: var(--color-faint);">
        {lastVagaDate ? `Atualizado em ${formatDate(lastVagaDate)}` : 'Data não disponível'} · Média geral <strong id="stat-media-inline">{media}%</strong> — {mediaLabel(media)}.
      </p>

      <!-- Cards de filtro: candidatura -->
      <div class="pt-8">
        <span class="text-[11px] uppercase tracking-[0.1em]" style="color: var(--color-faint); font-family: var(--font-body);">Por candidatura</span>
        <div data-animate class="mt-2 grid gap-4 grid-cols-2 sm:max-w-[400px]">
          {(['Sim', 'Não'] as const).map((v) => (
            <button
              type="button"
              class="stat-filter-card flex flex-col gap-1 rounded-2xl p-5 text-left"
              data-filter="candidatura" data-value={v}
              aria-pressed="false"
            >
              <span class="stat-filter-value font-display text-2xl font-bold text-neutral-900">{candidaturaCounts[v]}</span>
              <span class="text-sm" style="color: var(--color-faint);">Candidatura: {v}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Cards de filtro: status -->
      <div class="pt-6">
        <span class="text-[11px] uppercase tracking-[0.1em]" style="color: var(--color-faint); font-family: var(--font-body);">Por status</span>
        <div data-animate class="mt-2 grid gap-4 grid-cols-2 sm:grid-cols-4">
          {statusOptions.filter((s) => statusCounts[s] > 0).map((s) => (
            <button
              type="button"
              class="stat-filter-card flex flex-col gap-1 rounded-2xl p-5 text-left"
              data-filter="status" data-value={s}
              aria-pressed="false"
            >
              <span class="stat-filter-value font-display text-2xl font-bold text-neutral-900">{statusCounts[s]}</span>
              <span class="text-sm" style="color: var(--color-faint);">{s}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Fila de prioridade -->
    {filaPrioridade.length > 0 && (
      <section class="mx-auto w-full max-w-[1200px] px-6 pt-16">
        <h2 data-animate class="font-display text-[26px] font-semibold text-neutral-900 mb-1">Prioridade agora</h2>
        <p data-animate class="text-sm mb-7" style="color: var(--color-faint);">As 5 vagas ainda em jogo com maior score — dentre elas, as paradas há mais tempo aparecem primeiro.</p>
        <div class="flex flex-col gap-3">
          {filaPrioridade.map((v, i) => {
            const b = bandaCor[banda(v.score)];
            return (
              <div data-animate style={`--animate-delay: ${Math.min(i * 60, 240)}ms`} class="flex items-center gap-4 rounded-2xl border p-4">
                <span class="font-display text-2xl font-bold tabular-nums shrink-0" style={`color: ${b.fill}; min-width: 3.5ch;`}>{v.score}%</span>
                <div class="flex flex-col gap-0.5 min-w-0 flex-1">
                  <span class="font-body text-[15px] font-semibold text-neutral-900 truncate">{v.empresa}{v.produto && <span class="font-normal" style="color: var(--color-faint);"> · {v.produto}</span>}</span>
                  <span class="text-[12.5px]" style="color: var(--color-muted);">
                    {v.status}
                    {v.diasParado >= 0 ? ` · sem atualização há ${v.diasParado} dia${v.diasParado === 1 ? '' : 's'}` : ''}
                  </span>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- Funil de candidaturas -->
    <section class="mx-auto w-full max-w-[1200px] px-6 pt-16">
      <h2 data-animate class="font-display text-[26px] font-semibold text-neutral-900 mb-1">Funil de candidaturas</h2>
      <p data-animate class="text-sm mb-7" style="color: var(--color-faint);">
        Estágios ativos — {funilTerminal.recusado} recusada{funilTerminal.recusado === 1 ? '' : 's'} e {funilTerminal.arquivado} arquivada{funilTerminal.arquivado === 1 ? '' : 's'} ficam fora (estados terminais).
      </p>
      <div data-animate class="flex flex-col gap-2">
        {(() => {
          const maxCount = Math.max(1, ...funilCounts.map((f) => f.count));
          return funilCounts.map((f) => (
            <div class="flex items-center gap-3">
              <span class="text-[13px] shrink-0" style="color: var(--color-muted); width: 160px;">{f.status}</span>
              <div class="relative h-7 flex-1 overflow-hidden rounded-lg" style="background: var(--color-surface-2);">
                <div class="absolute inset-y-0 left-0 rounded-lg flex items-center justify-end pr-2" style={`width: ${Math.max(6, (f.count / maxCount) * 100)}%; background: var(--color-tag-research-bg, #d8e8ef);`}>
                  {f.count > 0 && <span class="text-[12px] font-semibold" style="color: var(--color-tag-research-text, #153c52);">{f.count}</span>}
                </div>
              </div>
            </div>
          ));
        })()}
      </div>
    </section>

    <!-- Board por status (kanban leve, só leitura) -->
    <section class="mx-auto w-full max-w-[1200px] px-6 pt-16">
      <h2 data-animate class="font-display text-[26px] font-semibold text-neutral-900 mb-1">Board por status</h2>
      <p data-animate class="text-sm mb-7" style="color: var(--color-faint);">Visão geral do pipeline num olhar só — só leitura, edite pelo card na lista abaixo.</p>
      <div data-animate class="flex gap-4 overflow-x-auto pb-2">
        {funilAtivo.map((status) => {
          const doStatus = vagas.filter((v) => v.status === status).sort((a, b) => b.score - a.score);
          return (
            <div class="flex flex-col gap-2 rounded-2xl border p-3 shrink-0" style="width: 220px; background: var(--color-surface-2);">
              <div class="flex items-center justify-between px-1">
                <span class="text-[12px] font-semibold" style="color: var(--color-muted);">{status}</span>
                <span class="text-[11px] tabular-nums" style="color: var(--color-faint);">{doStatus.length}</span>
              </div>
              <div class="flex flex-col gap-1.5">
                {doStatus.length === 0
                  ? <p class="text-[11px] px-1" style="color: var(--color-faint);">Vazio</p>
                  : doStatus.map((v) => {
                      const b = bandaCor[banda(v.score)];
                      return (
                        <div class="rounded-lg px-2.5 py-2 flex items-center gap-2" style="background: var(--color-surface);">
                          <span class="font-display text-[13px] font-bold tabular-nums shrink-0" style={`color: ${b.fill};`}>{v.score}%</span>
                          <span class="text-[12px] leading-tight truncate">{v.empresa}</span>
                        </div>
                      );
                    })
                }
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Ranking de vagas -->
    <section class="mx-auto w-full max-w-[1200px] px-6 pt-16">
      <div class="flex items-center justify-between gap-4 mb-1">
        <h2 data-animate class="font-display text-[26px] font-semibold text-neutral-900">Ranking de aderência</h2>
        {canEdit && (
          <button
            id="btn-nova-vaga"
            class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition-opacity hover:opacity-80"
            style="background: var(--color-neutral-900); color: #fff; font-family: var(--font-body);"
          >
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            Nova Vaga
          </button>
        )}
      </div>
      <p data-animate class="text-sm mb-4" style="color: var(--color-faint);">Ordenado do maior para o menor score.</p>

      <!-- Filtros -->
      <div data-animate class="flex flex-wrap items-center gap-x-6 gap-y-3 mb-6 pb-5" style="border-bottom: 1px solid var(--color-border);">
        <div class="relative flex items-center">
          <svg class="pointer-events-none absolute left-3" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" style="color: var(--color-faint);">
            <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.4"/>
            <path d="M9.5 9.5L13 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          <input
            id="search-empresa"
            type="search"
            placeholder="Buscar empresa…"
            aria-label="Buscar por nome da empresa"
            class="search-input rounded-full border py-1.5 pl-8 pr-3 text-[12px]"
            style="border-color: var(--color-border); background: var(--color-surface); color: var(--color-neutral-900); font-family: var(--font-body); width: 180px;"
          />
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[11px] uppercase tracking-[0.1em]" style="color: var(--color-faint); font-family: var(--font-body);">Candidatura</span>
          <div class="flex gap-1" role="group" aria-label="Filtrar por candidatura">
            {['', 'Sim', 'Não'].map((v) => (
              <button class={`filter-pill${v === '' ? ' filter-pill--active' : ''}`} data-filter="candidatura" data-value={v}>
                {v === '' ? 'Todas' : v}
              </button>
            ))}
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[11px] uppercase tracking-[0.1em]" style="color: var(--color-faint); font-family: var(--font-body);">Aderência</span>
          <div class="flex gap-1 flex-wrap" role="group" aria-label="Filtrar por aderência">
            {[
              { value: '', label: 'Todas' },
              { value: 'alta', label: 'Alta' },
              { value: 'parcial', label: 'Parcial' },
              { value: 'baixa', label: 'Baixa' },
              { value: 'muito-baixa', label: '<40%' },
            ].map(({ value, label }) => (
              <button class={`filter-pill${value === '' ? ' filter-pill--active' : ''}`} data-filter="banda" data-value={value}>
                {label}
              </button>
            ))}
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[11px] uppercase tracking-[0.1em]" style="color: var(--color-faint); font-family: var(--font-body);">Status</span>
          <select
            id="filter-status"
            aria-label="Filtrar por status"
            class="ja-select rounded-full border py-1 pl-3 pr-7 text-[11px] font-medium"
            style="border-color: var(--color-border); background: var(--color-surface); color: var(--color-muted); font-family: var(--font-body);"
          >
            <option value="">Todos</option>
            {statusOptions.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>
      </div>

      <div id="vagas-list" class="flex flex-col gap-4">
        {vagas.map((v, i) => {
          const b = bandaCor[banda(v.score)];
          return (
            <article
              data-animate
              data-slug={v.slug}
              data-candidatura={v.candidatura}
              data-banda={banda(v.score)}
              data-empresa={v.empresa.toLowerCase()}
              data-status={v.status}
              style={`--animate-delay: ${Math.min(i * 40, 300)}ms${v.status === 'Arquivado' ? '; display: none' : ''}`}
              class="vaga-card rounded-2xl border p-5 flex flex-col gap-3"
            >
              <!-- Header -->
              <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                <span class="font-display text-[19px] font-semibold text-neutral-900">{v.empresa}</span>
                {v.produto && <span class="text-sm" style="color: var(--color-faint);">· {v.produto}</span>}
              </div>
              <span class="text-sm" style="color: var(--color-muted);">{v.cargo}</span>

              <!-- Score bar -->
              <div class="flex items-center gap-3">
                <div class="relative h-2 flex-1 overflow-hidden rounded-full" style="background: var(--color-surface-2);">
                  <div class="score-fill absolute inset-y-0 left-0 rounded-full" style={`width: ${v.score}%; background: ${b.fill};`} />
                </div>
                <span class="score-value font-display text-[20px] font-bold tabular-nums text-neutral-900" style="min-width: 3ch; text-align: right;">{v.score}%</span>
              </div>

              <!-- Dias parado / prazo / tempo até resposta — só aparece com dado real (campos carimbados pelo servidor, nunca inferidos) -->
              {(() => {
                const emJogo = funilAtivo.includes(v.status);
                const parado = emJogo && v.diasParado >= 21;
                const prazoDias = v.prazoCandidatura ? Math.ceil((new Date(v.prazoCandidatura + 'T12:00:00').getTime() - Date.now()) / 86400000) : null;
                if (!parado && prazoDias === null && v.diasAteResposta === null) return null;
                return (
                  <div class="flex flex-wrap gap-2">
                    {v.diasAteResposta !== null && (
                      <span class="inline-flex w-fit items-center rounded-full px-2.5 py-1 text-[11px] font-semibold" style="background: rgba(21,128,61,0.1); color: #15803d;">
                        respondeu em {v.diasAteResposta} dia{v.diasAteResposta === 1 ? '' : 's'}
                      </span>
                    )}
                    {parado && (
                      <span class="inline-flex w-fit items-center rounded-full px-2.5 py-1 text-[11px] font-semibold" style="background: rgba(237,103,7,0.1); color: #ed6707;">
                        ⏱ sem atualização há {v.diasParado} dias
                      </span>
                    )}
                    {prazoDias !== null && (
                      <span class="inline-flex w-fit items-center rounded-full px-2.5 py-1 text-[11px] font-semibold" style={`background: ${prazoDias <= 3 ? 'rgba(185,28,28,0.1)' : 'rgba(0,0,0,0.05)'}; color: ${prazoDias <= 3 ? '#b91c1c' : 'var(--color-muted)'};`}>
                        {prazoDias >= 0 ? `prazo em ${prazoDias} dia${prazoDias === 1 ? '' : 's'}` : 'prazo vencido'}
                      </span>
                    )}
                  </div>
                );
              })()}

              <!-- Indicador de score mudado — só aparece se "**Score anterior:**" estiver preenchido no arquivo (convenção 2026-09-13, reanálise mudou o resultado) -->
              {v.scoreAnterior !== null && v.scoreAnterior !== v.score && (
                <div class="flex flex-col gap-1.5">
                  <span class="score-delta-badge inline-flex w-fit items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold"
                    style={`background: ${v.score > v.scoreAnterior ? 'rgba(21,128,61,0.1)' : 'rgba(185,28,28,0.1)'}; color: ${v.score > v.scoreAnterior ? '#15803d' : '#b91c1c'};`}>
                    {v.score > v.scoreAnterior ? '↑' : '↓'} score mudou de {v.scoreAnterior}% para {v.score}% numa reanálise
                  </span>
                  {v.motivoMudancaScore && (
                    <p class="text-[12px] leading-relaxed" style="color: var(--color-muted);"><strong>O que mudou:</strong> {v.motivoMudancaScore}</p>
                  )}
                </div>
              )}

              <!-- Texto de interpretação -->
              {v.interpretacaoTexto && (
                <p class="interp-text text-sm leading-relaxed italic" style="color: var(--color-muted);">"{v.interpretacaoTexto}"</p>
              )}

              <!-- Motivo provável da recusa — só aparece se status=Recusado e o campo estiver preenchido -->
              {v.status === 'Recusado' && v.motivoRecusa && (
                <p class="text-[12px] leading-relaxed rounded-lg px-3 py-2" style="background: rgba(185,28,28,0.08); border: 1px solid rgba(185,28,28,0.25); color: #b91c1c;">
                  <strong>Motivo provável:</strong> {v.motivoRecusa}
                </p>
              )}

              <!-- Checklist de preparo — só quando a entrevista já está marcada. Os 🔴 Bloqueadores
                   desta vaga específica são, por definição, as perguntas mais prováveis de aparecer. -->
              {v.status === 'Entrevista agendada' && v.bloqueadores.length > 0 && (
                <div class="rounded-lg px-3 py-2.5 flex flex-col gap-1.5" style="background: rgba(21,128,61,0.06); border: 1px solid rgba(21,128,61,0.2);">
                  <span class="text-[11px] font-semibold uppercase tracking-[0.06em]" style="color: #15803d;">Preparar resposta pra isso</span>
                  <ul class="flex flex-col gap-1">
                    {v.bloqueadores.map((item) => (
                      <li class="text-[12.5px] leading-snug flex items-start gap-1.5" style="color: var(--color-muted);">
                        <input type="checkbox" class="mt-0.5 shrink-0" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <!-- Tags de competências — laranja=hard skill, azul=soft skill;
                   preenchido=nota>=2 (você tem), contornado=nota<=1 (gap) -->
              {v.tags.length > 0 && (
                <div class="tags-list flex flex-wrap gap-1.5">
                  {v.tags.map((tag) => {
                    const hard  = tag.categoria === 'hard';
                    const bg    = tag.tenho ? (hard ? 'var(--color-tag-enterprise-bg)' : 'var(--color-tag-research-bg)') : 'transparent';
                    const color = hard ? 'var(--color-tag-enterprise-text)' : 'var(--color-tag-research-text)';
                    const border = tag.tenho ? 'none' : `1.5px solid ${color}`;
                    return (
                      <span class="rounded-full px-2.5 py-0.5 text-[11px] font-medium"
                        style={`background: ${bg}; color: ${color}; border: ${border}; font-family: var(--font-body);`}>
                        {tag.text}
                      </span>
                    );
                  })}
                </div>
              )}

              <!-- Footer -->
              <div class="flex flex-wrap items-center gap-2 pt-1">
                {v.data && (
                  <span class="text-[12px]" style="color: var(--color-faint);">
                    <span aria-hidden="true">📅</span> {formatDate(v.data)}
                  </span>
                )}
                {canEdit ? (
                  <button
                    class="candidatura-btn rounded-full border px-2.5 py-1 text-[11px] font-medium transition-opacity hover:opacity-70"
                    style="border-color: var(--color-border); color: var(--color-muted); font-family: var(--font-body);"
                    data-slug={v.slug} data-empresa={v.empresa} data-cargo={v.cargo}
                    data-candidatura={v.candidatura} data-status={v.status}
                    aria-label={`Editar candidatura de ${v.empresa}`}
                  >
                    Candidatura: <span class="candidatura-label font-semibold">{v.candidatura}</span>
                  </button>
                ) : (
                  <span
                    class="rounded-full border px-2.5 py-1 text-[11px] font-medium"
                    style="border-color: var(--color-border); color: var(--color-muted); font-family: var(--font-body);"
                  >
                    Candidatura: <span class="font-semibold">{v.candidatura}</span>
                  </span>
                )}
                <span class="interp-chip rounded-full px-2.5 py-1 text-[11px] font-medium"
                  style={`background: ${b.chipBg}; color: ${b.chipText};`}>
                  {v.interpretacao}
                </span>
                <span class="status-label rounded-full border px-2.5 py-1 text-[11px]">
                  {v.status}
                </span>
                <div class="ml-auto flex items-center gap-1.5">
                  {canEdit && (
                    <button
                      class="edit-btn flex items-center gap-1 rounded-full border px-2.5 py-1 text-[11px] font-medium transition-opacity hover:opacity-70"
                      style="border-color: var(--color-border); color: var(--color-faint); font-family: var(--font-body);"
                      data-slug={v.slug} data-empresa={v.empresa}
                      aria-label={`Reanalisar ${v.empresa}`}
                    >
                      <svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M8.5 1.5l2 2L3.5 10.5l-2.5.5.5-2.5L8.5 1.5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      Editar
                    </button>
                  )}
                  <button
                    class="expander-btn flex items-center gap-1 rounded-full border px-2.5 py-1 text-[11px] font-medium transition-opacity hover:opacity-70"
                    style="border-color: var(--color-border); color: var(--color-faint); font-family: var(--font-body);"
                    aria-expanded="false" aria-label={`Ver análise completa de ${v.empresa}`}
                  >
                    Ver análise
                    <svg class="expander-arrow" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                      <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Expander -->
              <div class="expander-content" aria-hidden="true">
                <div class="expander-inner">
                  <div class="flex flex-col gap-4 pt-4 mt-1" style="border-top: 1px solid var(--color-border);">

                    <!-- Breakdown do score -->
                    <div class="flex flex-col gap-2">
                      <span class="text-[11px] uppercase tracking-[0.1em]" style="color: var(--color-faint); font-family: var(--font-body);">Breakdown do score</span>
                      <div class="flex items-center gap-2">
                        <span class="text-[11px] shrink-0" style="color: var(--color-muted); width: 110px;">Obrigatórios ×2</span>
                        <div class="relative flex-1 h-1.5 rounded-full overflow-hidden" style="background: var(--color-surface-2);">
                          <div class="absolute inset-y-0 left-0 rounded-full" style={`width: ${v.maxObrigW > 0 ? Math.round(v.obtObrig / v.maxObrigW * 100) : 0}%; background: ${b.fill};`}></div>
                        </div>
                        <span class="text-[11px] tabular-nums shrink-0" style="color: var(--color-muted); min-width: 5ch; text-align: right;">{v.obtObrig}/{v.maxObrigW}</span>
                      </div>
                      <div class="flex items-center gap-2">
                        <span class="text-[11px] shrink-0" style="color: var(--color-muted); width: 110px;">Preferidos ×1</span>
                        <div class="relative flex-1 h-1.5 rounded-full overflow-hidden" style="background: var(--color-surface-2);">
                          <div class="absolute inset-y-0 left-0 rounded-full" style={`width: ${v.maxPrefW > 0 ? Math.round(v.obtPref / v.maxPrefW * 100) : 0}%; background: ${b.fill};`}></div>
                        </div>
                        <span class="text-[11px] tabular-nums shrink-0" style="color: var(--color-muted); min-width: 5ch; text-align: right;">{v.obtPref}/{v.maxPrefW}</span>
                      </div>
                    </div>

                    <!-- Gaps grid -->
                    <div class="gaps-grid grid gap-3">
                      <div class="flex flex-col gap-1.5">
                        <span class="text-[11px] font-semibold" style="color: #b91c1c; font-family: var(--font-body);">🔴 Bloqueadores</span>
                        {v.bloqueadores.length > 0
                          ? <ul class="flex flex-col gap-1">{v.bloqueadores.map((item) => <li class="text-[12px] leading-snug" style="color: var(--color-muted);">• {item}</li>)}</ul>
                          : <p class="text-[12px]" style="color: var(--color-faint);">Nenhum</p>
                        }
                      </div>
                      <div class="flex flex-col gap-1.5">
                        <span class="text-[11px] font-semibold" style="color: #b45309; font-family: var(--font-body);">🟡 Ausentes</span>
                        {v.ausentes.length > 0
                          ? <ul class="flex flex-col gap-1">{v.ausentes.map((item, idx) => <li class="text-[12px] leading-snug" style="color: var(--color-muted);">{idx + 1}. {item}</li>)}</ul>
                          : <p class="text-[12px]" style="color: var(--color-faint);">Nenhum</p>
                        }
                      </div>
                      <div class="flex flex-col gap-1.5">
                        <span class="text-[11px] font-semibold" style="color: #15803d; font-family: var(--font-body);">🟢 Boa aderência</span>
                        {v.boaAderencia.length > 0
                          ? <ul class="flex flex-col gap-1">{v.boaAderencia.map((item) => <li class="text-[12px] leading-snug" style="color: var(--color-muted);">• {item}</li>)}</ul>
                          : <p class="text-[12px]" style="color: var(--color-faint);">Nenhum</p>
                        }
                      </div>
                    </div>

                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Skills do bench — agregado de todos os requisitos obrigatórios de todas as
         vagas, pra uso em currículo/candidatura fora daqui, não só leitura do bench -->
    <section class="mx-auto w-full max-w-[1200px] px-6 pt-20">
      <h2 data-animate class="font-display text-[26px] font-semibold text-neutral-900 mb-1">Skills do bench</h2>
      <p data-animate class="text-sm mb-5" style="color: var(--color-muted);">
        Requisitos de todas as {vagas.length} vagas, agrupados num vocabulário fixo de competências (estilo LinkedIn) em vez do texto literal de cada JD. <b>Laranja</b> = hard skill, <b>azul</b> = soft skill. <b>Preenchido</b> = alguma análise já deu nota ≥2 pra essa competência (você comprova), <b>contornado</b> = gap em todas as vagas que a pediram. Frases de elegibilidade pura (anos de experiência, formação) ficam fora — não são competência.
      </p>
      <div class="flex gap-1 mb-5" role="group" aria-label="Filtrar skills">
        <button class="filter-pill filter-pill--active" data-skill-filter="todas">Todas ({skillsAgg.length})</button>
        <button class="filter-pill" data-skill-filter="tenho">Que tenho ({skillsTenhoCount})</button>
        <button class="filter-pill" data-skill-filter="gap">Que não tenho ({skillsGapCount})</button>
      </div>
      <div id="skills-agg-list" class="flex flex-wrap gap-1.5">
        {skillsAgg.map((s) => {
          const hard   = s.categoria === 'hard';
          const bg     = s.tenho ? (hard ? 'var(--color-tag-enterprise-bg)' : 'var(--color-tag-research-bg)') : 'transparent';
          const color  = hard ? 'var(--color-tag-enterprise-text)' : 'var(--color-tag-research-text)';
          const border = s.tenho ? 'none' : `1.5px solid ${color}`;
          return (
            <span
              data-skill-state={s.tenho ? 'tenho' : 'gap'}
              class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-medium"
              style={`background: ${bg}; color: ${color}; border: ${border}; font-family: var(--font-body);`}
            >
              {s.text}
              <span class="font-semibold opacity-70 tabular-nums">{s.count}</span>
            </span>
          );
        })}
      </div>
    </section>

    <!-- Gaps transversais -->
    <section class="mx-auto w-full max-w-[1200px] px-6 pt-20">
      <h2 data-animate class="font-display text-[26px] font-semibold text-neutral-900 mb-1">Gaps transversais</h2>
      <p data-animate class="text-sm mb-7" style="color: var(--color-faint);">Pendências presentes em todas as vagas — resolver aumenta o score de todas.</p>

      <div class="grid gap-4 sm:grid-cols-2">
        {gaps.map((g, i) => (
          <div data-animate style={`--animate-delay: ${Math.min(i * 60, 300)}ms`} class="flex flex-col gap-2 rounded-2xl border p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-body text-base font-semibold text-neutral-900">{g.gap}</h3>
              <span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.08em]"
                style="background: var(--color-tag-enterprise-bg); color: var(--color-tag-enterprise-text);">
                {g.impacto}
              </span>
            </div>
            <span class="text-[12px] uppercase tracking-[0.08em]" style="color: var(--color-faint);">Vagas: {g.vagas}</span>
            <p class="text-sm leading-relaxed" style="color: var(--color-muted);">{g.acao}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Matriz FOFA -->
    {fofa.length > 0 && (
      <section class="mx-auto w-full max-w-[1200px] px-6 pt-20">
        <h2 data-animate class="font-display text-[26px] font-semibold text-neutral-900 mb-1">Matriz FOFA</h2>
        <p data-animate class="text-sm mb-7 max-w-[760px] leading-relaxed" style="color: var(--color-faint);">
          Síntese de padrões que só aparecem lendo o bench inteiro, não vaga a vaga. Diferente dos Gaps transversais, esta seção <strong>não é recalculada a cada análise nova</strong> — só é atualizada quando pedida explicitamente.
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          {fofa.map((q, i) => (
            <div data-animate style={`--animate-delay: ${Math.min(i * 60, 300)}ms; border-color: ${fofaCor[q.emoji]?.border ?? '#e2e5eb'}; background: ${fofaCor[q.emoji]?.bg ?? 'transparent'};`} class="flex flex-col gap-3 rounded-2xl border p-5">
              <h3 class="font-body text-base font-semibold text-neutral-900">{q.emoji} {q.titulo}</h3>
              <div class="flex flex-col gap-3">
                {q.rows.map((row) => (
                  <div class="flex flex-col gap-0.5 pb-3" style="border-bottom: 1px solid rgba(0,0,0,0.06);">
                    <span class="text-sm font-semibold text-neutral-900">{row[0]}</span>
                    {row.slice(1).map((cell) => cell && <span class="text-[12.5px] leading-relaxed" style="color: var(--color-muted);">{cell}</span>)}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Metodologia -->
    <section class="mx-auto w-full max-w-[1200px] px-6 pt-20">
      <h2 data-animate class="font-display text-[26px] font-semibold text-neutral-900 mb-1">Metodologia de score</h2>
      <p data-animate class="text-sm mb-7 max-w-[760px] leading-relaxed" style="color: var(--color-muted);">
        Scoring ponderado baseado em <strong style="color: var(--color-neutral-800);">Person-Job Fit</strong>
        (Kristof, 1996; Edwards, 1991) — avalia a congruência entre as demandas da vaga e as evidências do
        portfolio. Tipo aplicado: <em>Demands-Abilities Fit</em>. Requisitos obrigatórios pesam 2×; diferenciais
        preferidos pesam 1×.
      </p>

      <div class="grid gap-8 lg:grid-cols-2">
        <div data-animate class="rounded-2xl border p-6">
          <h3 class="font-body text-sm font-semibold uppercase tracking-[0.1em] mb-4" style="color: var(--color-faint);">Rubrica (0–3)</h3>
          <ul class="flex flex-col gap-3">
            {rubrica.map((r) => (
              <li class="flex gap-3">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full font-display text-sm font-bold"
                  style="background: var(--color-surface-2); color: var(--color-neutral-900);">{r.nota}</span>
                <span class="text-sm leading-relaxed pt-0.5" style="color: var(--color-muted);">{r.criterio}</span>
              </li>
            ))}
          </ul>
        </div>

        <div data-animate style="--animate-delay: 80ms" class="rounded-2xl border p-6">
          <h3 class="font-body text-sm font-semibold uppercase tracking-[0.1em] mb-4" style="color: var(--color-faint);">Interpretação do score</h3>
          <ul class="flex flex-col gap-3">
            <li class="flex items-baseline gap-3">
              <span class="font-display font-bold tabular-nums text-neutral-900" style="min-width: 6ch;">80–100%</span>
              <span class="text-sm" style="color: var(--color-muted);">Alta aderência — submeter.</span>
            </li>
            <li class="flex items-baseline gap-3">
              <span class="font-display font-bold tabular-nums text-neutral-900" style="min-width: 6ch;">60–79%</span>
              <span class="text-sm" style="color: var(--color-muted);">Parcial — gaps endereçáveis, resolver antes de submeter.</span>
            </li>
            <li class="flex items-baseline gap-3">
              <span class="font-display font-bold tabular-nums text-neutral-900" style="min-width: 6ch;">40–59%</span>
              <span class="text-sm" style="color: var(--color-muted);">Baixa — gaps significativos, trabalhar portfolio.</span>
            </li>
            <li class="flex items-baseline gap-3">
              <span class="font-display font-bold tabular-nums text-neutral-900" style="min-width: 6ch;">&lt; 40%</span>
              <span class="text-sm" style="color: var(--color-muted);">Desalinhamento estrutural — reavaliar.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

  </main>

  <!-- Modal: Editar Candidatura -->
  <dialog id="modal-candidatura" class="ja-modal rounded-2xl p-0 shadow-2xl w-full max-w-sm">
    <form id="form-candidatura" class="flex flex-col gap-5 p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="font-display text-lg font-semibold text-neutral-900">Candidatura</h2>
          <p id="modal-empresa-label" class="text-sm mt-0.5" style="color: var(--color-faint);"></p>
        </div>
        <button type="button" class="modal-close shrink-0 rounded-full p-1.5 hover:opacity-60 transition-opacity"
          aria-label="Fechar" style="color: var(--color-faint);">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <input type="hidden" id="modal-slug" name="slug" />

      <fieldset class="flex gap-4">
        <legend class="text-sm font-medium text-neutral-900 mb-2">Enviou candidatura?</legend>
        <label class="flex items-center gap-2 cursor-pointer text-sm" style="color: var(--color-muted);">
          <input type="radio" name="candidatura" value="Sim" class="accent-neutral-900" /> Sim
        </label>
        <label class="flex items-center gap-2 cursor-pointer text-sm" style="color: var(--color-muted);">
          <input type="radio" name="candidatura" value="Não" class="accent-neutral-900" /> Não
        </label>
      </fieldset>

      <div class="flex flex-col gap-1.5">
        <label for="modal-status" class="text-sm font-medium text-neutral-900">Status</label>
        <select id="modal-status" name="status" class="ja-select rounded-lg border px-3 py-2 text-sm w-full"
          style="border-color: var(--color-border); color: var(--color-muted); background: var(--color-surface);">
          {statusOptions.map((s) => <option value={s}>{s}</option>)}
        </select>
      </div>

      <div id="modal-candidatura-error" class="hidden text-sm text-red-600"></div>

      <div class="flex gap-2 justify-end">
        <button type="button" class="modal-close rounded-full px-4 py-2 text-sm border transition-opacity hover:opacity-70"
          style="border-color: var(--color-border); color: var(--color-muted);">Cancelar</button>
        <button type="submit" class="rounded-full px-4 py-2 text-sm font-medium transition-opacity hover:opacity-80"
          style="background: var(--color-neutral-900); color: #fff;">Salvar</button>
      </div>
    </form>
  </dialog>

  <!-- Modal: Nova Vaga -->
  <dialog id="modal-nova-vaga" class="ja-modal rounded-2xl p-0 shadow-2xl w-full max-w-lg">
    <form id="form-nova-vaga" class="flex flex-col gap-4 p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 id="modal-nova-title" class="font-display text-lg font-semibold text-neutral-900">Nova Vaga</h2>
          <p id="modal-nova-subtitle" class="text-sm mt-0.5" style="color: var(--color-faint);">Cole a descrição da vaga — a IA gera a análise completa.</p>
        </div>
        <button type="button" class="modal-close shrink-0 rounded-full p-1.5 hover:opacity-60 transition-opacity"
          aria-label="Fechar" style="color: var(--color-faint);">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <input type="hidden" id="nv-slug" name="slug" />

      <textarea id="nv-jd" name="jd" rows="12" required
        class="ja-input rounded-lg border px-3 py-2.5 text-sm resize-y"
        style="border-color: var(--color-border); color: var(--color-neutral-900); background: var(--color-surface); min-height: 200px;"
        placeholder="Cole aqui o título, empresa e descrição completa da vaga..."></textarea>

      <div id="modal-nova-error" class="hidden text-sm text-red-600"></div>

      <div class="flex gap-2 justify-end">
        <button type="button" class="modal-close rounded-full px-4 py-2 text-sm border transition-opacity hover:opacity-70"
          style="border-color: var(--color-border); color: var(--color-muted);">Cancelar</button>
        <button type="submit" id="btn-criar-vaga" class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition-opacity hover:opacity-80"
          style="background: var(--color-neutral-900); color: #fff;">
          <span id="btn-criar-label">Analisar com IA</span>
        </button>
      </div>
    </form>
  </dialog>

  <Footer lang="pt" />
</Base>

<style>
  .vaga-card,
  section .rounded-2xl.border {
    border-color: var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 40%, transparent);
  }

  .status-label {
    border-color: var(--color-border);
    color: var(--color-faint);
  }

  /* Recusado: automático via data-status — nenhuma vaga futura precisa de código novo pra herdar isso.
     Prefixado com "section" pra empatar em especificidade com a regra base (`section .rounded-2xl.border`)
     acima — sem isso, a borda cinza padrão vencia mesmo com data-status="Recusado". */
  section .vaga-card[data-status="Recusado"] {
    border-color: #b91c1c;
  }
  section .vaga-card[data-status="Recusado"] .status-label {
    border-color: #b91c1c;
    color: #b91c1c;
  }

  .stat-card {
    background: var(--color-surface);
  }

  .stat-filter-card {
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    cursor: pointer;
    transition: border-color 0.15s, opacity 0.15s;
    width: 100%;
  }
  .stat-filter-card:hover {
    opacity: 0.85;
  }
  .stat-filter-card--active {
    border-color: var(--color-neutral-900);
  }

  /* Modais */
  .ja-modal {
    border: 1px solid var(--color-border);
    background: var(--color-surface, #fff);
    color: inherit;
    max-height: 90dvh;
    overflow-y: auto;
  }

  .ja-modal::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
  }

  .ja-input:focus,
  .ja-select:focus {
    outline: 2px solid var(--color-neutral-900);
    outline-offset: 1px;
  }

  .search-input:focus {
    outline: 2px solid var(--color-neutral-900);
    outline-offset: 1px;
  }
  .search-input::-webkit-search-cancel-button {
    cursor: pointer;
  }

  /* Expander */
  .expander-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s ease;
  }
  .expander-content.open {
    grid-template-rows: 1fr;
  }
  .expander-inner {
    overflow: hidden;
  }
  .expander-arrow {
    transition: transform 0.2s ease;
  }
  .gaps-grid {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }

  /* Filter pills */
  .filter-pill {
    border-radius: 9999px;
    padding: 3px 10px;
    font-size: 11px;
    font-family: var(--font-body);
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    border: none;
    background: var(--color-surface-2);
    color: var(--color-muted);
  }
  .filter-pill--active {
    background: var(--color-neutral-900) !important;
    color: #fff !important;
  }
</style>

<script>
  // ---- Utilitários ----

  const BAND_COLORS = {
    alta:          { fill: '#2f6e3f', chipBg: 'var(--color-tag-research-bg)',   chipText: 'var(--color-tag-research-text)'   },
    parcial:       { fill: '#4d6046', chipBg: 'var(--color-tag-dataviz-bg)',    chipText: 'var(--color-tag-dataviz-text)'    },
    baixa:         { fill: '#ed6707', chipBg: 'var(--color-tag-enterprise-bg)', chipText: 'var(--color-tag-enterprise-text)' },
    'muito-baixa': { fill: '#8c2f0d', chipBg: 'var(--color-tag-enterprise-bg)', chipText: 'var(--color-tag-enterprise-text)' },
  } as const;

  function banda(score: number): 'alta' | 'parcial' | 'baixa' | 'muito-baixa' {
    if (score >= 80) return 'alta';
    if (score >= 60) return 'parcial';
    if (score >= 40) return 'baixa';
    return 'muito-baixa';
  }

  function scoreLabel(score: number) {
    if (score >= 80) return 'Alta aderência';
    if (score >= 60) return 'Aderência parcial';
    if (score >= 40) return 'Aderência baixa';
    return 'Desalinhamento estrutural';
  }

  function formatDate(dateStr: string) {
    const parts = dateStr.split('-');
    if (parts.length !== 3) return dateStr;
    return `${parts[2]}/${parts[1]}/${parts[0]}`;
  }

  // ---- Modal genérico ----

  function openModal(dialog: HTMLDialogElement) {
    dialog.showModal();
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    }, { once: true });
  }

  document.querySelectorAll('.modal-close').forEach((btn) => {
    btn.addEventListener('click', () => {
      (btn.closest('dialog') as HTMLDialogElement)?.close();
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('dialog[open]').forEach((d) => (d as HTMLDialogElement).close());
    }
  });

  // ---- Filtro de Skills do bench (Todas / Que tenho / Que não tenho) ----
  // Independente do resto — não participa das facetas cruzadas de vaga, é só
  // show/hide dos pills pela nota agregada já calculada no servidor.

  document.querySelectorAll<HTMLButtonElement>('[data-skill-filter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.skillFilter ?? 'todas';
      document.querySelectorAll<HTMLButtonElement>('[data-skill-filter]').forEach((b) => {
        b.classList.toggle('filter-pill--active', b === btn);
      });
      document.querySelectorAll<HTMLElement>('#skills-agg-list [data-skill-state]').forEach((pill) => {
        const state = pill.dataset.skillState;
        const show = filter === 'todas' || filter === state;
        pill.style.display = show ? '' : 'none';
      });
    });
  });

  // ---- Filtros ----

  const activeFilters = { candidatura: '', banda: '', empresa: '', status: '' };
  type FilterDim = 'candidatura' | 'banda' | 'empresa' | 'status';

  // Verifica se um card atende aos filtros ativos, ignorando a dimensão `exclude`
  // — usado tanto para mostrar/ocultar cards quanto para recalcular as contagens
  // dos cards de "Por candidatura" / "Por status" (facetas cruzadas).
  function cardMatches(card: HTMLElement, exclude?: FilterDim): boolean {
    if (exclude !== 'candidatura' && activeFilters.candidatura && card.dataset.candidatura !== activeFilters.candidatura) return false;
    if (exclude !== 'banda' && activeFilters.banda && card.dataset.banda !== activeFilters.banda) return false;
    if (exclude !== 'empresa' && activeFilters.empresa && !(card.dataset.empresa ?? '').includes(activeFilters.empresa)) return false;
    if (exclude !== 'status') {
      if (activeFilters.status) {
        if (card.dataset.status !== activeFilters.status) return false;
      } else if (card.dataset.status === 'Arquivado') {
        return false; // arquivadas ficam ocultas por padrão
      }
    }
    return true;
  }

  function applyFilters() {
    document.querySelectorAll<HTMLElement>('.vaga-card').forEach((card) => {
      card.style.display = cardMatches(card) ? '' : 'none';
    });
    updateStatCounts();
  }

  function updateStatCounts() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.vaga-card'));

    document.querySelectorAll<HTMLElement>('.stat-filter-card[data-filter="candidatura"]').forEach((c) => {
      const value = c.dataset.value ?? '';
      const count = cards.filter((card) => card.dataset.candidatura === value && cardMatches(card, 'candidatura')).length;
      const valEl = c.querySelector<HTMLElement>('.stat-filter-value');
      if (valEl) valEl.textContent = String(count);
    });

    document.querySelectorAll<HTMLElement>('.stat-filter-card[data-filter="status"]').forEach((c) => {
      const value = c.dataset.value ?? '';
      const count = cards.filter((card) => card.dataset.status === value && cardMatches(card, 'status')).length;
      const valEl = c.querySelector<HTMLElement>('.stat-filter-value');
      if (valEl) valEl.textContent = String(count);
    });
  }

  const statusSelect = document.getElementById('filter-status') as HTMLSelectElement | null;

  function setCandidatura(value: string) {
    activeFilters.candidatura = value;
    document.querySelectorAll<HTMLButtonElement>('.filter-pill[data-filter="candidatura"]').forEach((p) => {
      p.classList.toggle('filter-pill--active', p.dataset.value === value);
    });
    document.querySelectorAll<HTMLButtonElement>('.stat-filter-card[data-filter="candidatura"]').forEach((c) => {
      const active = c.dataset.value === value;
      c.classList.toggle('stat-filter-card--active', active);
      c.setAttribute('aria-pressed', String(active));
    });
    applyFilters();
  }

  function setStatus(value: string) {
    activeFilters.status = value;
    if (statusSelect) statusSelect.value = value;
    document.querySelectorAll<HTMLButtonElement>('.stat-filter-card[data-filter="status"]').forEach((c) => {
      const active = c.dataset.value === value;
      c.classList.toggle('stat-filter-card--active', active);
      c.setAttribute('aria-pressed', String(active));
    });
    applyFilters();
  }

  document.querySelectorAll<HTMLButtonElement>('.filter-pill').forEach((pill) => {
    pill.addEventListener('click', () => {
      const filterType = pill.dataset.filter as 'candidatura' | 'banda';
      const value = pill.dataset.value ?? '';
      if (filterType === 'candidatura') {
        setCandidatura(value);
        return;
      }
      activeFilters[filterType] = value;
      document.querySelectorAll<HTMLButtonElement>(`.filter-pill[data-filter="${filterType}"]`).forEach((p) => {
        p.classList.toggle('filter-pill--active', p.dataset.value === value);
      });
      applyFilters();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.stat-filter-card').forEach((card) => {
    card.addEventListener('click', () => {
      const filterType = card.dataset.filter as 'candidatura' | 'status';
      const value = card.dataset.value ?? '';
      const isActive = card.classList.contains('stat-filter-card--active');
      const newValue = isActive ? '' : value; // clicar de novo no card ativo limpa o filtro
      if (filterType === 'candidatura') setCandidatura(newValue);
      else setStatus(newValue);
    });
  });

  const searchInput = document.getElementById('search-empresa') as HTMLInputElement | null;
  searchInput?.addEventListener('input', () => {
    activeFilters.empresa = searchInput.value.trim().toLowerCase();
    applyFilters();
  });

  statusSelect?.addEventListener('change', () => {
    setStatus(statusSelect.value);
  });

  // ---- Modal Candidatura ----

  const modalCandidatura  = document.getElementById('modal-candidatura') as HTMLDialogElement;
  const formCandidatura   = document.getElementById('form-candidatura') as HTMLFormElement;
  const modalEmpresaLabel = document.getElementById('modal-empresa-label') as HTMLElement;
  const modalSlugInput    = document.getElementById('modal-slug') as HTMLInputElement;
  const modalStatusSel    = document.getElementById('modal-status') as HTMLSelectElement;
  const modalCandErr      = document.getElementById('modal-candidatura-error') as HTMLElement;

  function wireCandidaturaBtn(btn: HTMLButtonElement) {
    btn.addEventListener('click', () => {
      const { slug, empresa, cargo, candidatura, status } = btn.dataset;
      modalSlugInput.value = slug ?? '';
      modalEmpresaLabel.textContent = `${empresa} · ${cargo}`;
      const radio = formCandidatura.querySelector<HTMLInputElement>(`input[value="${candidatura}"]`);
      if (radio) radio.checked = true;
      const opt = modalStatusSel.querySelector<HTMLOptionElement>(`option[value="${status}"]`);
      if (opt) opt.selected = true;
      modalCandErr.classList.add('hidden');
      modalCandErr.textContent = '';
      openModal(modalCandidatura);
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.candidatura-btn').forEach(wireCandidaturaBtn);

  formCandidatura.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(formCandidatura);
    const slug        = data.get('slug') as string;
    const candidatura = data.get('candidatura') as string;
    const status      = data.get('status') as string;

    if (!candidatura) {
      modalCandErr.textContent = 'Selecione Sim ou Não.';
      modalCandErr.classList.remove('hidden');
      return;
    }

    const btn = formCandidatura.querySelector<HTMLButtonElement>('[type="submit"]')!;
    btn.disabled = true;
    btn.textContent = 'Salvando…';

    try {
      const res = await fetch('/api/jobanalysis-update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug, candidatura, status }),
      });
      if (!res.ok) throw new Error((await res.json()).error ?? 'Erro desconhecido');

      const card = document.querySelector<HTMLElement>(`.vaga-card[data-slug="${slug}"]`);
      if (card) {
        const candBtn   = card.querySelector<HTMLButtonElement>('.candidatura-btn')!;
        const candLabel = candBtn.querySelector<HTMLElement>('.candidatura-label')!;
        const statusLbl = card.querySelector<HTMLElement>('.status-label')!;
        candLabel.textContent       = candidatura;
        candBtn.dataset.candidatura = candidatura;
        candBtn.dataset.status      = status;
        statusLbl.textContent       = status;
        card.dataset.candidatura    = candidatura; // mantém filtro atualizado
        card.dataset.status         = status; // mantém filtro atualizado
      }

      applyFilters();
      modalCandidatura.close();
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : 'Erro ao salvar';
      modalCandErr.textContent = msg;
      modalCandErr.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Salvar';
    }
  });

  // ---- Modal Nova Vaga / Reanalisar ----

  const modalNovaVaga     = document.getElementById('modal-nova-vaga') as HTMLDialogElement;
  const formNovaVaga      = document.getElementById('form-nova-vaga') as HTMLFormElement;
  const modalNovaErr      = document.getElementById('modal-nova-error') as HTMLElement;
  const modalNovaTitle    = document.getElementById('modal-nova-title') as HTMLElement;
  const modalNovaSubtitle = document.getElementById('modal-nova-subtitle') as HTMLElement;
  const nvSlugInput       = document.getElementById('nv-slug') as HTMLInputElement;

  document.getElementById('btn-nova-vaga')?.addEventListener('click', () => {
    nvSlugInput.value = '';
    formNovaVaga.reset();
    modalNovaTitle.textContent    = 'Nova Vaga';
    modalNovaSubtitle.textContent = 'Cole a descrição da vaga — a IA gera a análise completa.';
    modalNovaErr.classList.add('hidden');
    openModal(modalNovaVaga);
  });

  function wireEditBtn(btn: HTMLButtonElement) {
    btn.addEventListener('click', () => {
      const { slug, empresa } = btn.dataset;
      nvSlugInput.value = slug ?? '';
      (document.getElementById('nv-jd') as HTMLTextAreaElement).value = '';
      modalNovaTitle.textContent    = `Reanalisar: ${empresa}`;
      modalNovaSubtitle.textContent = 'Cole a nova descrição — o arquivo será sobrescrito com a nova análise.';
      modalNovaErr.classList.add('hidden');
      openModal(modalNovaVaga);
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.edit-btn').forEach(wireEditBtn);

  // ---- buildCardHTML ----

  function buildCardHTML(v: {
    slug: string; empresa: string; produto: string; cargo: string;
    score: number; interpretacao: string; interpretacaoTexto: string;
    status: string; candidatura: string; motivoRecusa?: string; scoreAnterior?: number | null; motivoMudancaScore?: string;
    diasParado?: number; prazoCandidatura?: string; diasAteResposta?: number | null; data: string; tags: string[];
    bloqueadores?: string[]; ausentes?: string[]; boaAderencia?: string[];
    obtObrig?: number; maxObrigW?: number; obtPref?: number; maxPrefW?: number;
  }): string {
    const b         = BAND_COLORS[banda(v.score)];
    const dateFmt   = v.data ? formatDate(v.data) : '';
    const blk       = v.bloqueadores  ?? [];
    const aus       = v.ausentes      ?? [];
    const boa       = v.boaAderencia  ?? [];
    const obtObrig  = v.obtObrig  ?? 0;
    const maxObrigW = v.maxObrigW ?? 0;
    const obtPref   = v.obtPref   ?? 0;
    const maxPrefW  = v.maxPrefW  ?? 0;

    const tagsHTML = v.tags.length
      ? `<div class="tags-list flex flex-wrap gap-1.5">${v.tags.map((t) =>
          `<span class="rounded-full px-2.5 py-0.5 text-[11px] font-medium" style="background: var(--color-surface-2); color: var(--color-muted);">${t}</span>`
        ).join('')}</div>`
      : '';
    const interpHTML = v.interpretacaoTexto
      ? `<p class="interp-text text-sm leading-relaxed italic" style="color: var(--color-muted);">"${v.interpretacaoTexto}"</p>`
      : '';
    const motivoHTML = v.status === 'Recusado' && v.motivoRecusa
      ? `<p class="text-[12px] leading-relaxed rounded-lg px-3 py-2" style="background: rgba(185,28,28,0.08); border: 1px solid rgba(185,28,28,0.25); color: #b91c1c;"><strong>Motivo provável:</strong> ${v.motivoRecusa}</p>`
      : '';
    const scoreDeltaHTML = (v.scoreAnterior != null && v.scoreAnterior !== v.score)
      ? `<div class="flex flex-col gap-1.5">
          <span class="score-delta-badge inline-flex w-fit items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold"
            style="background: ${v.score > v.scoreAnterior ? 'rgba(21,128,61,0.1)' : 'rgba(185,28,28,0.1)'}; color: ${v.score > v.scoreAnterior ? '#15803d' : '#b91c1c'};">
            ${v.score > v.scoreAnterior ? '↑' : '↓'} score mudou de ${v.scoreAnterior}% para ${v.score}% numa reanálise
          </span>
          ${v.motivoMudancaScore ? `<p class="text-[12px] leading-relaxed" style="color: var(--color-muted);"><strong>O que mudou:</strong> ${v.motivoMudancaScore}</p>` : ''}
        </div>`
      : '';
    const dateHTML = dateFmt
      ? `<span class="text-[12px]" style="color: var(--color-faint);"><span aria-hidden="true">📅</span> ${dateFmt}</span>`
      : '';

    // Mesma lista de "funil ativo" do servidor (astro frontmatter) — duplicada aqui
    // porque este script client-side roda num contexto JS separado, sem acesso
    // às consts do componente Astro.
    const FUNIL_ATIVO = ['A avaliar', 'Candidatura enviada', 'Entrevista agendada', 'Em processo', 'Proposta recebida'];
    const diasParado = v.diasParado ?? -1;
    const emJogo = FUNIL_ATIVO.includes(v.status);
    const parado = emJogo && diasParado >= 21;
    const prazoDias = v.prazoCandidatura ? Math.ceil((new Date(v.prazoCandidatura + 'T12:00:00').getTime() - Date.now()) / 86400000) : null;
    const diasAteResposta = v.diasAteResposta ?? null;
    const prazoHTML = (parado || prazoDias !== null || diasAteResposta !== null)
      ? `<div class="flex flex-wrap gap-2">
          ${diasAteResposta !== null ? `<span class="inline-flex w-fit items-center rounded-full px-2.5 py-1 text-[11px] font-semibold" style="background: rgba(21,128,61,0.1); color: #15803d;">respondeu em ${diasAteResposta} dia${diasAteResposta === 1 ? '' : 's'}</span>` : ''}
          ${parado ? `<span class="inline-flex w-fit items-center rounded-full px-2.5 py-1 text-[11px] font-semibold" style="background: rgba(237,103,7,0.1); color: #ed6707;">⏱ sem atualização há ${diasParado} dias</span>` : ''}
          ${prazoDias !== null ? `<span class="inline-flex w-fit items-center rounded-full px-2.5 py-1 text-[11px] font-semibold" style="background: ${prazoDias <= 3 ? 'rgba(185,28,28,0.1)' : 'rgba(0,0,0,0.05)'}; color: ${prazoDias <= 3 ? '#b91c1c' : 'var(--color-muted)'};">${prazoDias >= 0 ? `prazo em ${prazoDias} dia${prazoDias === 1 ? '' : 's'}` : 'prazo vencido'}</span>` : ''}
        </div>`
      : '';

    const checklistHTML = (v.status === 'Entrevista agendada' && blk.length > 0)
      ? `<div class="rounded-lg px-3 py-2.5 flex flex-col gap-1.5" style="background: rgba(21,128,61,0.06); border: 1px solid rgba(21,128,61,0.2);">
          <span class="text-[11px] font-semibold uppercase tracking-[0.06em]" style="color: #15803d;">Preparar resposta pra isso</span>
          <ul class="flex flex-col gap-1">${blk.map((item) =>
            `<li class="text-[12.5px] leading-snug flex items-start gap-1.5" style="color: var(--color-muted);"><input type="checkbox" class="mt-0.5 shrink-0" /><span>${item}</span></li>`
          ).join('')}</ul>
        </div>`
      : '';

    const gapList = (items: string[], type: 'bloq' | 'aus' | 'boa') =>
      items.length === 0
        ? `<p class="text-[12px]" style="color: var(--color-faint);">Nenhum</p>`
        : `<ul class="flex flex-col gap-1">${items.map((item, i) =>
            `<li class="text-[12px] leading-snug" style="color: var(--color-muted);">${type === 'aus' ? `${i + 1}.` : '•'} ${item}</li>`
          ).join('')}</ul>`;

    const obrigPct  = maxObrigW > 0 ? Math.round(obtObrig  / maxObrigW  * 100) : 0;
    const prefPct   = maxPrefW  > 0 ? Math.round(obtPref   / maxPrefW   * 100) : 0;

    return `
      <article data-slug="${v.slug}" data-candidatura="${v.candidatura}" data-banda="${banda(v.score)}" data-empresa="${v.empresa.toLowerCase()}" data-status="${v.status}"
        class="vaga-card rounded-2xl border p-5 flex flex-col gap-3"
        style="background: color-mix(in srgb, var(--color-surface) 40%, transparent);${v.status === 'Arquivado' ? ' display: none;' : ''}"
        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
          <span class="font-display text-[19px] font-semibold text-neutral-900">${v.empresa}</span>
          ${v.produto ? `<span class="text-sm" style="color: var(--color-faint);">· ${v.produto}</span>` : ''}
        </div>
        <span class="text-sm" style="color: var(--color-muted);">${v.cargo}</span>
        <div class="flex items-center gap-3">
          <div class="relative h-2 flex-1 overflow-hidden rounded-full" style="background: var(--color-surface-2);">
            <div class="score-fill absolute inset-y-0 left-0 rounded-full" style="width: ${v.score}%; background: ${b.fill};"></div>
          </div>
          <span class="score-value font-display text-[20px] font-bold tabular-nums text-neutral-900" style="min-width: 3ch; text-align: right;">${v.score}%</span>
        </div>
        ${prazoHTML}
        ${scoreDeltaHTML}
        ${interpHTML}
        ${motivoHTML}
        ${checklistHTML}
        ${tagsHTML}
        <div class="flex flex-wrap items-center gap-2 pt-1">
          ${dateHTML}
          <button class="candidatura-btn rounded-full border px-2.5 py-1 text-[11px] font-medium transition-opacity hover:opacity-70"
            style="border-color: var(--color-border); color: var(--color-muted); font-family: var(--font-body);"
            data-slug="${v.slug}" data-empresa="${v.empresa}" data-cargo="${v.cargo}"
            data-candidatura="${v.candidatura}" data-status="${v.status}"
            aria-label="Editar candidatura de ${v.empresa}">
            Candidatura: <span class="candidatura-label font-semibold">${v.candidatura}</span>
          </button>
          <span class="interp-chip rounded-full px-2.5 py-1 text-[11px] font-medium" style="background: ${b.chipBg}; color: ${b.chipText};">${v.interpretacao}</span>
          <span class="status-label rounded-full border px-2.5 py-1 text-[11px]">${v.status}</span>
          <div class="ml-auto flex items-center gap-1.5">
            <button class="edit-btn flex items-center gap-1 rounded-full border px-2.5 py-1 text-[11px] font-medium transition-opacity hover:opacity-70"
              style="border-color: var(--color-border); color: var(--color-faint); font-family: var(--font-body);"
              data-slug="${v.slug}" data-empresa="${v.empresa}" aria-label="Reanalisar ${v.empresa}">
              <svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M8.5 1.5l2 2L3.5 10.5l-2.5.5.5-2.5L8.5 1.5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Editar
            </button>
            <button class="expander-btn flex items-center gap-1 rounded-full border px-2.5 py-1 text-[11px] font-medium transition-opacity hover:opacity-70"
              style="border-color: var(--color-border); color: var(--color-faint); font-family: var(--font-body);"
              aria-expanded="false" aria-label="Ver análise completa de ${v.empresa}">
              Ver análise
              <svg class="expander-arrow" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>
        <div class="expander-content" aria-hidden="true">
          <div class="expander-inner">
            <div class="flex flex-col gap-4 pt-4 mt-1" style="border-top: 1px solid var(--color-border);">
              <div class="flex flex-col gap-2">
                <span class="text-[11px] uppercase tracking-[0.1em]" style="color: var(--color-faint); font-family: var(--font-body);">Breakdown do score</span>
                <div class="flex items-center gap-2">
                  <span class="text-[11px] shrink-0" style="color: var(--color-muted); width: 110px;">Obrigatórios ×2</span>
                  <div class="relative flex-1 h-1.5 rounded-full overflow-hidden" style="background: var(--color-surface-2);">
                    <div class="absolute inset-y-0 left-0 rounded-full" style="width: ${obrigPct}%; background: ${b.fill};"></div>
                  </div>
                  <span class="text-[11px] tabular-nums shrink-0" style="color: var(--color-muted); min-width: 5ch; text-align: right;">${obtObrig}/${maxObrigW}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-[11px] shrink-0" style="color: var(--color-muted); width: 110px;">Preferidos ×1</span>
                  <div class="relative flex-1 h-1.5 rounded-full overflow-hidden" style="background: var(--color-surface-2);">
                    <div class="absolute inset-y-0 left-0 rounded-full" style="width: ${prefPct}%; background: ${b.fill};"></div>
                  </div>
                  <span class="text-[11px] tabular-nums shrink-0" style="color: var(--color-muted); min-width: 5ch; text-align: right;">${obtPref}/${maxPrefW}</span>
                </div>
              </div>
              <div class="gaps-grid grid gap-3">
                <div class="flex flex-col gap-1.5">
                  <span class="text-[11px] font-semibold" style="color: #b91c1c; font-family: var(--font-body);">🔴 Bloqueadores</span>
                  ${gapList(blk, 'bloq')}
                </div>
                <div class="flex flex-col gap-1.5">
                  <span class="text-[11px] font-semibold" style="color: #b45309; font-family: var(--font-body);">🟡 Ausentes</span>
                  ${gapList(aus, 'aus')}
                </div>
                <div class="flex flex-col gap-1.5">
                  <span class="text-[11px] font-semibold" style="color: #15803d; font-family: var(--font-body);">🟢 Boa aderência</span>
                  ${gapList(boa, 'boa')}
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>`;
  }

  // ---- updateStats ----

  function updateStats() {
    const scores = Array.from(document.querySelectorAll<HTMLElement>('.vaga-card'))
      .map((c) => {
        const val = c.querySelector<HTMLElement>('.score-value')?.textContent?.replace('%', '');
        return val ? parseInt(val) : null;
      })
      .filter((s): s is number => s !== null);

    if (!scores.length) return;
    const total    = scores.length;
    const media    = Math.round(scores.reduce((a, b) => a + b, 0) / total);
    const maxScore = Math.max(...scores);
    const parciais = scores.filter((s) => s >= 60).length;

    const el = (id: string) => document.getElementById(id);
    const statTotal   = el('stat-total');        if (statTotal)   statTotal.textContent   = String(total);
    const statMedia   = el('stat-media');        if (statMedia)   statMedia.textContent   = `${media}%`;
    const statMax     = el('stat-max');          if (statMax)     statMax.textContent     = `${maxScore}%`;
    const statParciais = el('stat-parciais');    if (statParciais) statParciais.textContent = String(parciais);
    const statInline  = el('stat-media-inline'); if (statInline)  statInline.textContent  = `${media}%`;
  }

  // ---- wireNewCard ----

  function wireExpanderBtns(container: HTMLElement | Document) {
    container.querySelectorAll<HTMLButtonElement>('.expander-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card    = btn.closest('.vaga-card') as HTMLElement;
        const content = card.querySelector<HTMLElement>('.expander-content')!;
        const arrow   = btn.querySelector<SVGElement>('.expander-arrow') as HTMLElement;
        const isOpen  = content.classList.contains('open');
        content.classList.toggle('open', !isOpen);
        content.setAttribute('aria-hidden', String(isOpen));
        btn.setAttribute('aria-expanded', String(!isOpen));
        arrow.style.transform = isOpen ? '' : 'rotate(180deg)';
      });
    });
  }

  wireExpanderBtns(document);

  function wireNewCard(card: HTMLElement) {
    card.querySelectorAll<HTMLButtonElement>('.candidatura-btn').forEach(wireCandidaturaBtn);
    card.querySelectorAll<HTMLButtonElement>('.edit-btn').forEach(wireEditBtn);
    wireExpanderBtns(card);
  }

  // ---- Submit Nova Vaga / Reanalisar ----

  formNovaVaga.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data         = new FormData(formNovaVaga);
    const jd           = (data.get('jd') as string)?.trim();
    const existingSlug = nvSlugInput.value.trim();

    if (!jd) {
      modalNovaErr.textContent = 'Cole a descrição da vaga.';
      modalNovaErr.classList.remove('hidden');
      return;
    }

    const btn   = formNovaVaga.querySelector<HTMLButtonElement>('#btn-criar-vaga')!;
    const label = document.getElementById('btn-criar-label')!;
    btn.disabled     = true;
    label.textContent = existingSlug ? 'Reanalisando…' : 'Analisando…';

    try {
      const body: Record<string, string> = { jd };
      if (existingSlug) body.slug = existingSlug;

      const res = await fetch('/api/jobanalysis-analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error((await res.json()).error ?? 'Erro desconhecido');

      const vaga = await res.json();
      const list = document.getElementById('vagas-list')!;

      if (existingSlug) {
        // Modo edição: substitui o card existente
        const oldCard = list.querySelector<HTMLElement>(`.vaga-card[data-slug="${existingSlug}"]`);
        const tmp = document.createElement('div');
        tmp.innerHTML = buildCardHTML(vaga);
        const newCard = tmp.firstElementChild as HTMLElement;
        if (oldCard) {
          oldCard.replaceWith(newCard);
        } else {
          list.appendChild(newCard);
        }
        wireNewCard(newCard);
      } else {
        // Modo criação: insere ordenado por score desc
        const existingCards = Array.from(list.querySelectorAll<HTMLElement>('.vaga-card'));

        // Aviso de empresa repetida — checa ANTES de inserir o card novo, senão
        // ele mesmo apareceria como "duplicata de si mesmo" na comparação.
        const empresaDup = existingCards.some((c) => c.dataset.empresa === vaga.empresa.toLowerCase());

        const insertBefore  = existingCards.find((c) => {
          const s = parseInt(c.querySelector<HTMLElement>('.score-value')?.textContent ?? '0');
          return s < vaga.score;
        });
        const tmp = document.createElement('div');
        tmp.innerHTML = buildCardHTML(vaga);
        const newCard = tmp.firstElementChild as HTMLElement;
        if (insertBefore) {
          list.insertBefore(newCard, insertBefore);
        } else {
          list.appendChild(newCard);
        }
        if (empresaDup) {
          const warn = document.createElement('p');
          warn.className = 'text-[12px] leading-relaxed rounded-lg px-3 py-2';
          warn.style.cssText = 'background: rgba(180,83,9,0.08); border: 1px solid rgba(180,83,9,0.25); color: #b45309;';
          warn.textContent = `⚠ Já existe outra vaga analisada da ${vaga.empresa} no bench — confira se não é a mesma antes de duplicar esforço.`;
          newCard.insertBefore(warn, newCard.children[1] ?? null);
        }
        if (vaga.duplicateSlugWarning) {
          const warn = document.createElement('p');
          warn.className = 'text-[12px] leading-relaxed rounded-lg px-3 py-2';
          warn.style.cssText = 'background: rgba(180,83,9,0.08); border: 1px solid rgba(180,83,9,0.25); color: #b45309;';
          warn.textContent = `⚠ ${vaga.duplicateSlugWarning}`;
          newCard.insertBefore(warn, newCard.children[1] ?? null);
        }
        wireNewCard(newCard);
      }

      applyFilters();
      updateStats();
      modalNovaVaga.close();
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : 'Erro ao analisar';
      modalNovaErr.textContent = msg;
      modalNovaErr.classList.remove('hidden');
    } finally {
      btn.disabled      = false;
      label.textContent = 'Analisar com IA';
    }
  });
</script>
